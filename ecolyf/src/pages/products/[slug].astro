---
import MainLayout from '../../layouts/MainLayout.astro';
import productsData from '../../data/products.json';

export function getStaticPaths() {
  return productsData.map(product => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;
---

<MainLayout title={`${product.name} | EcoLyf Exports`} description={product.description}>
  
  <div class="bg-gray-50 border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4 py-3 text-[10px] font-bold uppercase tracking-[0.2em] text-gray-400">
      <a href="/" class="hover:text-green-600 transition-colors">Home</a> <span class="mx-2 text-gray-300">/</span> 
      <a href="/products" class="hover:text-green-600 transition-colors">Catalog</a> <span class="mx-2 text-gray-300">/</span> 
      <span class="text-gray-900">{product.name}</span>
    </div>
  </div>

  <div class="max-w-7xl mx-auto py-10 px-4 grid grid-cols-1 lg:grid-cols-12 gap-12">
    
    <div class="lg:col-span-5">
      <div class="sticky top-28">
        <div class="bg-white rounded-xl overflow-hidden border border-gray-200 shadow-lg mb-4 aspect-square relative">
          <img src={product.image} alt={product.name} class="w-full h-full object-cover" />
          <div class="absolute bottom-3 right-3 bg-white/90 backdrop-blur-sm text-gray-900 text-[9px] font-bold px-2 py-1 rounded border border-gray-200 uppercase tracking-widest">
            Technical View
          </div>
        </div>
        
        <div class="grid grid-cols-4 gap-3">
          <button class="aspect-square bg-white rounded-lg border-2 border-green-500 overflow-hidden shadow-sm">
            <img src={product.image} class="w-full h-full object-cover" />
          </button>
          <div class="aspect-square bg-gray-50 rounded-lg border border-gray-100 flex flex-col items-center justify-center text-[9px] font-bold text-gray-400 uppercase text-center p-2">
             Side
          </div>
          <div class="aspect-square bg-gray-50 rounded-lg border border-gray-100 flex flex-col items-center justify-center text-[9px] font-bold text-gray-400 uppercase text-center p-2">
             Pack
          </div>
          <div class="aspect-square bg-gray-50 rounded-lg border border-gray-100 flex flex-col items-center justify-center text-[9px] font-bold text-gray-400 uppercase text-center p-2">
             Dims
          </div>
        </div>
      </div>
    </div>

    <div class="lg:col-span-7">
      <div class="mb-4 flex items-center justify-between">
        <span class="bg-gray-100 text-gray-700 text-[9px] font-bold px-3 py-1 rounded border border-gray-200 uppercase tracking-widest">
          {product.category}
        </span>
        <div class="flex items-center text-[10px] font-bold text-green-600 uppercase tracking-widest">
          <span class="w-1.5 h-1.5 bg-green-500 rounded-full mr-2"></span>
          Export Ready
        </div>
      </div>
      
      <h1 class="text-3xl lg:text-4xl font-bold text-gray-900 mb-4 tracking-tight leading-tight">{product.name}</h1>
      <p class="text-lg text-gray-500 mb-8 leading-relaxed max-w-2xl">{product.description}</p>
      
      <div class="bg-white rounded-xl p-6 mb-10 border border-gray-200 shadow-sm relative overflow-hidden group">
        <div class="grid grid-cols-2 md:grid-cols-3 gap-6 mb-8 pb-6 border-b border-gray-100">
          <div>
            <p class="text-[9px] text-green-600 uppercase font-bold tracking-[0.2em] mb-1">Min. Order (MOQ)</p>
            <p class="text-xl font-bold text-gray-900">50,000 <span class="text-[10px] text-gray-400 font-normal uppercase">pcs</span></p>
          </div>
          <div>
            <p class="text-[9px] text-green-600 uppercase font-bold tracking-[0.2em] mb-1">Production Lead</p>
            <p class="text-xl font-bold text-gray-900">15-20 <span class="text-[10px] text-gray-400 font-normal uppercase">Days</span></p>
          </div>
          <div class="col-span-2 md:col-span-1">
            <p class="text-[9px] text-green-600 uppercase font-bold tracking-[0.2em] mb-1">Dispatch Port</p>
            <p class="text-xl font-bold text-gray-900 uppercase">Tuticorin</p>
          </div>
        </div>
        
        <div class="flex flex-col sm:flex-row gap-3">
          <a href="/#quote" class="flex-1 text-center bg-green-600 text-white px-6 py-3.5 rounded-lg hover:bg-green-700 transition-all font-bold text-sm uppercase tracking-wider">
            Request Pricing
          </a>
          
          <a href="#" class="flex items-center justify-center bg-gray-50 border border-gray-200 text-gray-600 px-6 py-3.5 rounded-lg hover:bg-white hover:border-gray-300 transition-all font-bold text-sm uppercase tracking-wider group/btn">
            <svg class="w-4 h-4 mr-2 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
            Specs Sheet
          </a>
        </div>

        <div class="mt-6 flex flex-wrap justify-between items-center text-[9px] font-bold text-gray-400 uppercase tracking-widest px-1">
          <span class="flex items-center gap-1.5">✓ Private Label OEM</span>
          <span class="flex items-center gap-1.5">✓ SGS / FDA Certified</span>
          <span class="flex items-center gap-1.5">✓ Global Logistics</span>
        </div>
      </div>

      <div>
        <h3 class="text-[10px] font-bold text-gray-400 uppercase tracking-[0.3em] mb-5 flex items-center">
          <span class="w-6 h-px bg-green-500 mr-2"></span>
          Supply Advantages
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {product.features.map(feature => (
            <div class="flex items-center bg-gray-50/50 p-3.5 rounded-lg border border-gray-100 transition-colors hover:border-green-200">
              <div class="w-5 h-5 rounded-full bg-green-100 flex items-center justify-center mr-3">
                <svg class="w-2.5 h-2.5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="4"><path d="M5 13l4 4L19 7"></path></svg>
              </div>
              <span class="text-gray-700 font-bold text-xs tracking-tight">{feature}</span>
            </div>
          ))}
        </div>
      </div>
      
    </div>
  </div>
</MainLayout>