---
import MainLayout from '../../layouts/MainLayout.astro';
import productsData from '../../data/products.json';

export function getStaticPaths() {
  return productsData.map(product => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;
---

<MainLayout title={`${product.name} | EcoLyf Exports`} description={product.description}>
  
  <div class="bg-brand-50 border-b border-brand-100">
    <div class="max-w-7xl mx-auto px-4 py-3 text-[10px] font-bold uppercase tracking-[0.2em] text-brand-500">
      <a href="/" class="hover:text-brand-700 transition-colors">Home</a> <span class="mx-2 text-brand-300">/</span> 
      <a href="/products" class="hover:text-brand-700 transition-colors">Catalog</a> <span class="mx-2 text-brand-300">/</span> 
      <span class="text-brand-950">{product.name}</span>
    </div>
  </div>

  <div class="max-w-7xl mx-auto py-10 px-4 grid grid-cols-1 lg:grid-cols-12 gap-12">
    
    <div class="lg:col-span-5">
      <div class="sticky top-28">
        <div class="bg-white rounded-xl overflow-hidden border border-brand-100 shadow-sm mb-4 aspect-square relative group">
          <img src={product.image} alt={product.name} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
          
          <div class="absolute bottom-3 right-3 bg-brand-950 text-white text-[9px] font-bold px-2 py-1 rounded border border-brand-800 uppercase tracking-widest shadow-sm">
            Technical View
          </div>
        </div>
        
        <div class="grid grid-cols-4 gap-3">
          <button class="aspect-square bg-white rounded-lg border-2 border-brand-600 overflow-hidden shadow-sm">
            <img src={product.image} class="w-full h-full object-cover" />
          </button>
          
          <div class="aspect-square bg-brand-50 rounded-lg border border-brand-100 flex flex-col items-center justify-center text-[9px] font-bold text-brand-400 uppercase text-center p-2 hover:border-brand-300 transition-colors cursor-not-allowed">
             Side
          </div>
          <div class="aspect-square bg-brand-50 rounded-lg border border-brand-100 flex flex-col items-center justify-center text-[9px] font-bold text-brand-400 uppercase text-center p-2 hover:border-brand-300 transition-colors cursor-not-allowed">
             Pack
          </div>
          <div class="aspect-square bg-brand-50 rounded-lg border border-brand-100 flex flex-col items-center justify-center text-[9px] font-bold text-brand-400 uppercase text-center p-2 hover:border-brand-300 transition-colors cursor-not-allowed">
             Dims
          </div>
        </div>
      </div>
    </div>

    <div class="lg:col-span-7">
      <div class="mb-4 flex items-center justify-between">
        <span class="bg-brand-50 text-brand-800 text-[9px] font-bold px-3 py-1 rounded border border-brand-200 uppercase tracking-widest">
          {product.category}
        </span>
        <div class="flex items-center text-[10px] font-bold text-brand-600 uppercase tracking-widest">
          <span class="w-1.5 h-1.5 bg-brand-500 rounded-full mr-2"></span>
          Export Ready
        </div>
      </div>
      
      <h1 class="text-3xl lg:text-4xl font-black text-brand-950 mb-4 tracking-tight leading-tight">{product.name}</h1>
      <p class="text-lg text-brand-800 mb-8 leading-relaxed max-w-2xl font-medium">{product.description}</p>
      
      <div class="bg-white rounded-xl p-6 mb-10 border border-brand-100 shadow-sm relative overflow-hidden">
        <div class="grid grid-cols-2 md:grid-cols-3 gap-6 mb-8 pb-6 border-b border-brand-100">
          <div>
            <p class="text-[9px] text-brand-600 uppercase font-bold tracking-[0.2em] mb-1">Min. Order (MOQ)</p>
            <p class="text-xl font-black text-brand-950">50,000 <span class="text-[10px] text-brand-500 font-bold uppercase">pcs</span></p>
          </div>
          <div>
            <p class="text-[9px] text-brand-600 uppercase font-bold tracking-[0.2em] mb-1">Production Lead</p>
            <p class="text-xl font-black text-brand-950">15-20 <span class="text-[10px] text-brand-500 font-bold uppercase">Days</span></p>
          </div>
          <div class="col-span-2 md:col-span-1">
            <p class="text-[9px] text-brand-600 uppercase font-bold tracking-[0.2em] mb-1">Dispatch Port</p>
            <p class="text-xl font-black text-brand-950 uppercase">Tuticorin</p>
          </div>
        </div>
        
        <div class="flex flex-col sm:flex-row gap-3">
          <a href="/#quote" class="flex-1 text-center bg-brand-600 text-white px-6 py-3.5 rounded-lg hover:bg-brand-700 shadow-sm hover:shadow transition-all font-bold text-sm uppercase tracking-wider">
            Request Pricing
          </a>
          
          <a href="#" class="flex items-center justify-center bg-brand-50 border border-brand-200 text-brand-800 px-6 py-3.5 rounded-lg hover:bg-white hover:border-brand-400 transition-all font-bold text-sm uppercase tracking-wider group">
            <svg class="w-4 h-4 mr-2 text-brand-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
            Specs Sheet
          </a>
        </div>

        <div class="mt-6 flex flex-wrap justify-between items-center text-[9px] font-bold text-brand-500 uppercase tracking-widest px-1">
          <span class="flex items-center gap-1.5">✓ Private Label OEM</span>
          <span class="flex items-center gap-1.5">✓ SGS / FDA Certified</span>
          <span class="flex items-center gap-1.5">✓ Global Logistics</span>
        </div>
      </div>

      <div>
        <h3 class="text-[10px] font-bold text-brand-500 uppercase tracking-[0.3em] mb-5 flex items-center">
          <span class="w-6 h-px bg-brand-500 mr-2"></span>
          Supply Advantages
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {product.features.map(feature => (
            <div class="flex items-center bg-brand-50/50 p-3.5 rounded-lg border border-brand-100 transition-colors hover:border-brand-300 hover:bg-brand-50">
              <div class="w-5 h-5 rounded-full bg-white border border-brand-100 flex items-center justify-center mr-3 shadow-sm">
                <svg class="w-2.5 h-2.5 text-brand-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="4"><path d="M5 13l4 4L19 7"></path></svg>
              </div>
              <span class="text-brand-950 font-bold text-xs tracking-tight">{feature}</span>
            </div>
          ))}
        </div>
      </div>
      
    </div>
  </div>
</MainLayout>