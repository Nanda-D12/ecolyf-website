---
import MainLayout from '../../layouts/MainLayout.astro';
// Assuming your new JSON is saved as catalog.json
import catalogData from '../../data/catalog.json';

// 1. DATA TRANSFORMATION: Dynamically generate routes based on the Family names
export function getStaticPaths() {
  const paths = [];
  
  Object.entries(catalogData).forEach(([categoryName, categoryFamilies]) => {
    Object.entries(categoryFamilies).forEach(([familyName, familyData]) => {
      paths.push({
        // URL slug generated from the family name
        params: { slug: familyName.toLowerCase().replace(/\s+/g, '-') },
        props: { 
          category: categoryName,
          name: familyName, 
          data: familyData 
        },
      });
    });
  });
  
  return paths;
}

const { category, name, data } = Astro.props;

// Helper to convert technical JSON keys to readable table labels
const formatSpecKey = (key) => {
  const result = key.replace(/([A-Z])/g, ' $1').trim();
  return result.charAt(0).toUpperCase() + result.slice(1);
};
---

<MainLayout title={`${name} | EcoLyf Master Catalog`} description={`Technical specifications and supply details for ${name}.`}>
  
  <div class="bg-brand-50 border-b border-brand-100">
    <div class="max-w-7xl mx-auto px-4 py-3 text-[10px] font-bold uppercase tracking-[0.2em] text-brand-500">
      <a href="/" class="hover:text-brand-700 transition-colors">Home</a> <span class="mx-2 text-brand-300">/</span> 
      <a href="/products" class="hover:text-brand-700 transition-colors">Products</a> <span class="mx-2 text-brand-300">/</span> 
      <a href="#" class="hover:text-brand-700 transition-colors">{category}</a> <span class="mx-2 text-brand-300">/</span> 
      <span class="text-brand-950">{name}</span>
    </div>
  </div>

  <div class="max-w-7xl mx-auto py-12 px-4 border-b border-brand-100">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <div class="lg:col-span-7">
        <span class="bg-brand-50 text-brand-800 text-[9px] font-bold px-3 py-1 rounded border border-brand-200 uppercase tracking-widest inline-block mb-4">
          Product Family: {category}
        </span>
        <h1 class="text-4xl md:text-5xl font-black text-brand-950 mb-6 tracking-tight leading-tight">{name}</h1>
        
        <div class="flex flex-wrap gap-3 mb-8">
          {data.Attributes && data.Attributes.map(attr => (
            <div class="bg-brand-50/50 px-4 py-2 rounded-lg border border-brand-100 flex items-center">
              <div class="w-1.5 h-1.5 rounded-full bg-brand-500 mr-2 shrink-0"></div>
              <span class="text-brand-950 font-bold text-xs uppercase tracking-tight">{attr}</span>
            </div>
          ))}
        </div>

        <div class="flex flex-col sm:flex-row gap-4">
          <a href="/#quote" class="text-center bg-brand-600 text-white px-8 py-4 rounded-lg hover:bg-brand-700 shadow-sm hover:shadow transition-all font-bold text-sm uppercase tracking-wider">
            Request Master Quote
          </a>
          <div class="flex items-center justify-center bg-brand-50 border border-brand-200 text-brand-800 px-6 py-4 rounded-lg font-bold text-[10px] uppercase tracking-widest">
            Base MOQ: {data.MOQ ? data.MOQ.toLocaleString() : '50,000'} Units
          </div>
        </div>
      </div>

      <div class="lg:col-span-5">
        <div class="bg-brand-50 rounded-2xl border border-brand-100 p-8 aspect-[4/3] flex items-center justify-center relative overflow-hidden shadow-inner">
          <div class="absolute top-4 right-4 bg-white text-brand-600 text-[9px] font-bold px-3 py-1 rounded-full border border-brand-200 uppercase tracking-widest shadow-sm z-10">
            {data.Items.length} Sizes
          </div>
          <img 
            src={data.image || `/images/categories/${name.toLowerCase().replace(/\s+/g, '-')}.webp`} 
            alt={name} 
            class="w-full h-full object-contain drop-shadow-xl"
            onerror="this.src='/images/placeholder.webp'"
          />
        </div>
      </div>

    </div>
  </div>

  <div class="bg-gray-50/50 py-16 border-b border-brand-100">
    <div class="max-w-7xl mx-auto px-4">
      
      <div class="mb-10 flex items-center justify-between">
        <h2 class="text-2xl font-black text-brand-950 tracking-tight">Available Specifications</h2>
        <span class="text-xs font-bold text-brand-500 uppercase tracking-widest">Lead Time: {data.LeadTime || "15-25 Days"}</span>
      </div>

      <div class="space-y-12">
        {data.Items.map((item, index) => (
          <div class="bg-white rounded-2xl border border-brand-100 shadow-sm overflow-hidden flex flex-col md:flex-row group transition-all hover:shadow-md">
            
            <div class="md:w-1/3 bg-brand-50 p-6 flex flex-col justify-between border-r border-brand-100 relative">
              <div class="absolute top-4 left-4 bg-white text-brand-800 text-[9px] font-black px-2 py-1 rounded border border-brand-200 uppercase tracking-widest shadow-sm">
                SKU {index + 1}
              </div>
              
              <div class="aspect-square flex items-center justify-center mb-4">
                <img 
                  src={item.image || `/images/products/${item.Name.toLowerCase().replace(/\s+/g, '-')}.webp`} 
                  alt={item.Name} 
                  class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-500 drop-shadow-md"
                  onerror="this.src='/images/placeholder.webp'"
                />
              </div>

              <div class="grid grid-cols-3 gap-2">
                <div class="aspect-square bg-white rounded border border-brand-200 opacity-100"></div>
                <div class="aspect-square bg-brand-100 rounded border border-brand-100 opacity-50"></div>
                <div class="aspect-square bg-brand-100 rounded border border-brand-100 opacity-50"></div>
              </div>
            </div>

            <div class="md:w-2/3 p-6 md:p-8 flex flex-col justify-center">
              <h3 class="text-xl font-black text-brand-950 mb-6">{item.Name}</h3>
              
              <div class="border border-brand-100 rounded-xl overflow-hidden">
                <table class="w-full text-left border-collapse text-sm">
                  <tbody>
                    {Object.entries(item).filter(([key]) => key !== 'Name' && key !== 'image').map(([key, value], i) => (
                      <tr class={`transition-colors hover:bg-brand-50/80 ${i % 2 === 0 ? 'bg-brand-50/30' : 'bg-white'}`}>
                        <td class="py-3 px-4 border-b border-brand-50 font-black text-brand-900 w-1/3">
                          {formatSpecKey(key)}
                        </td>
                        <td class="py-3 px-4 border-b border-brand-50 text-brand-800 font-medium">
                          {value}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>

            </div>
          </div>
        ))}
      </div>

    </div>
  </div>

</MainLayout>