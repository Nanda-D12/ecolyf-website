---
import MainLayout from '../../layouts/MainLayout.astro';
import productsData from '../../data/products.json';

export function getStaticPaths() {
  return productsData.map(product => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;
---

<MainLayout title={`${product.name} | EcoLyf Exports`} description={product.description}>
  
  <div class="bg-gray-50 border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4 py-3 text-sm text-gray-500">
      <a href="/" class="hover:text-green-700">Home</a> <span class="mx-2">/</span> 
      <a href="/products" class="hover:text-green-700">Catalog</a> <span class="mx-2">/</span> 
      <span class="text-gray-900 font-semibold">{product.name}</span>
    </div>
  </div>

  <div class="max-w-7xl mx-auto py-12 px-4 grid grid-cols-1 lg:grid-cols-12 gap-12">
    
    <div class="lg:col-span-5 relative">
      <div class="sticky top-24">
        <div class="bg-white rounded-xl overflow-hidden border border-gray-200 shadow-sm mb-4 aspect-square">
          <img src={product.image} alt={product.name} class="w-full h-full object-cover" />
        </div>
        
        <div class="grid grid-cols-4 gap-3">
          <div class="aspect-square bg-gray-100 rounded-lg border-2 border-green-600 cursor-pointer overflow-hidden"><img src="/mobile-hero.webp" class="w-full h-full object-cover opacity-80" /></div>
          <div class="aspect-square bg-gray-100 rounded-lg border border-gray-200 cursor-pointer flex items-center justify-center text-xs text-gray-400">Side View</div>
          <div class="aspect-square bg-gray-100 rounded-lg border border-gray-200 cursor-pointer flex items-center justify-center text-xs text-gray-400">Packaging</div>
          <div class="aspect-square bg-gray-100 rounded-lg border border-gray-200 cursor-pointer flex items-center justify-center text-xs text-gray-400">Dimensions</div>
        </div>
      </div>
    </div>

    <div class="lg:col-span-7">
      <div class="mb-4 flex items-center justify-between">
        <span class="bg-green-100 text-green-800 text-xs font-extrabold px-3 py-1.5 rounded-sm uppercase tracking-widest border border-green-200">
          {product.category}
        </span>
        <span class="text-sm font-semibold text-gray-500 flex items-center">
          <svg class="w-4 h-4 mr-1 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          Export Ready
        </span>
      </div>
      
      <h1 class="text-4xl lg:text-5xl font-extrabold text-gray-900 mb-6 leading-tight tracking-tight">{product.name}</h1>
      <p class="text-xl text-gray-600 mb-8 leading-relaxed">{product.description}</p>
      
      <div class="bg-gradient-to-br from-green-50 to-white border border-green-200 rounded-xl p-8 mb-10 shadow-sm relative overflow-hidden">
        <div class="absolute top-0 right-0 w-16 h-16 bg-green-100 rounded-bl-full -mr-8 -mt-8 opacity-50"></div>
        
        <div class="grid grid-cols-2 md:grid-cols-3 gap-6 mb-8 border-b border-green-100 pb-6">
          <div>
            <p class="text-xs text-green-800 uppercase font-bold tracking-wider mb-1">Standard MOQ</p>
            <p class="text-xl font-black text-gray-900">50,000 <span class="text-sm font-medium text-gray-500">pcs</span></p>
          </div>
          <div>
            <p class="text-xs text-green-800 uppercase font-bold tracking-wider mb-1">Lead Time</p>
            <p class="text-xl font-black text-gray-900">15-20 <span class="text-sm font-medium text-gray-500">Days</span></p>
          </div>
          <div class="col-span-2 md:col-span-1">
            <p class="text-xs text-green-800 uppercase font-bold tracking-wider mb-1">FOB Port</p>
            <p class="text-xl font-black text-gray-900">Tuticorin / Chennai</p>
          </div>
        </div>
        
        <a href="/#quote" class="block w-full text-center bg-green-700 text-white px-8 py-4 rounded-lg hover:bg-green-800 font-extrabold text-lg transition-all shadow-lg hover:shadow-xl transform hover:-translate-y-0.5">
          Request FOB/CIF Container Pricing
        </a>
        
        <a href="#" class="mt-4 flex items-center justify-center w-full text-center bg-white border-2 border-green-700 text-green-800 px-8 py-3 rounded-lg hover:bg-green-50 font-bold transition-colors">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
          Download Technical Data Sheet (PDF)
        </a>
        <p class="text-center text-sm text-gray-500 mt-4 flex items-center justify-center gap-4 font-medium">
          <span>✓ Private Label OEM</span>
          <span>✓ SGS Certified</span>
        </p>
      </div>

      <div class="mb-10">
        <h3 class="text-2xl font-bold text-gray-900 mb-6 flex items-center">
          <svg class="w-6 h-6 mr-2 text-green-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
          Technical Specifications
        </h3>
        <div class="bg-white border border-gray-200 rounded-lg overflow-hidden shadow-sm">
          <table class="w-full text-left text-gray-700">
            <tbody class="divide-y divide-gray-200">
              {Object.entries(product.specs).map(([key, value], index) => (
                <tr class={index % 2 === 0 ? 'bg-gray-50' : 'bg-white'}>
                  <td class="py-4 px-6 font-semibold capitalize w-1/3 text-gray-900">
                    {key.replace(/([A-Z])/g, ' $1').trim()}
                  </td>
                  <td class="py-4 px-6 font-medium text-gray-600">{value}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <div>
        <h4 class="text-xl font-bold text-gray-900 mb-4">Product Advantages</h4>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {product.features.map(feature => (
            <div class="flex items-start bg-gray-50 p-3 rounded border border-gray-100">
              <svg class="w-5 h-5 text-green-600 mr-2 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              <span class="text-gray-700 font-medium text-sm">{feature}</span>
            </div>
          ))}
        </div>
      </div>
      
    </div>
  </div>
</MainLayout>