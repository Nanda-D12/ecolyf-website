---
import MainLayout from '../../layouts/MainLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import productsData from '../../data/products.json';
---

<MainLayout 
  title="Complete Catalog" 
  description="Browse our full range of export-quality bagasse tableware."
>
<div class="relative bg-green-950 text-white overflow-hidden py-24 px-4 border-b border-green-800/50 shadow-inner">
    
    <img 
      src="/mobile-hero.webp" 
      alt="EcoLyf Bagasse Production Line" 
      class="absolute inset-0 w-full h-full object-cover opacity-30" 
    />

    <div class="relative z-10 max-w-7xl mx-auto flex flex-col items-center text-center">
      <span class="text-green-300 font-semibold tracking-wider uppercase text-sm mb-3">Global Supply Chain Partner</span>
      <h1 class="text-5xl md:text-6xl font-extrabold tracking-tight mb-5 leading-tight text-white drop-shadow-lg">
        Product <span class="text-green-400">Catalog</span>
      </h1>
      <p class="text-xl text-green-100 max-w-2xl leading-relaxed">
        Browse our full range of 100% biodegradable, compostable, and plastic-free tableware. Manufactured to strict international standards for global export.
      </p>
    </div>
  </div>
  <div class="max-w-7xl mx-auto px-4 pt-12 pb-4">
    <h3 class="text-lg font-bold text-gray-900 mb-5">Filter by Product Category:</h3>
    <div class="flex flex-wrap gap-4" id="category-filters">
      
      <button data-filter="all" class="group bg-green-50 border border-green-500 px-5 py-2.5 rounded-full text-sm font-medium text-green-800 transition-all flex items-center cursor-pointer">
        View All
      </button>

      <button data-filter="plates" class="group bg-white border border-gray-200 px-5 py-2.5 rounded-full text-sm font-medium text-gray-700 hover:border-green-600 hover:text-green-800 transition-all shadow-sm hover:shadow-md flex items-center cursor-pointer">
        <svg class="w-5 h-5 mr-2 text-gray-400 group-hover:text-green-600 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <circle cx="12" cy="12" r="9" stroke-width="1.5"></circle>
          <circle cx="12" cy="12" r="5" stroke-width="1.5" opacity="0.5"></circle>
        </svg>
        Plates
      </button>

      <button data-filter="trays" class="group bg-white border border-gray-200 px-5 py-2.5 rounded-full text-sm font-medium text-gray-700 hover:border-green-600 hover:text-green-800 transition-all shadow-sm hover:shadow-md flex items-center cursor-pointer">
        <svg class="w-5 h-5 mr-2 text-gray-400 group-hover:text-green-600 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <rect x="3" y="6" width="18" height="12" rx="2" stroke-width="1.5"></rect>
          <path d="M8 6v12M16 6v12" stroke-width="1.5" opacity="0.5"></path>
        </svg>
        Trays
      </button>

      <button data-filter="bowls" class="group bg-white border border-gray-200 px-5 py-2.5 rounded-full text-sm font-medium text-gray-700 hover:border-green-600 hover:text-green-800 transition-all shadow-sm hover:shadow-md flex items-center cursor-pointer">
        <svg class="w-5 h-5 mr-2 text-gray-400 group-hover:text-green-600 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path d="M4 9h16a8 8 0 01-16 0z" stroke-width="1.5"></path>
        </svg>
        Bowls & Clamshells
      </button>

    </div>
  </div>

  <section class="py-16 px-4 max-w-7xl mx-auto min-h-[50vh]">
    <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-8">
      {productsData.map(product => (
        <ProductCard product={product} />
      ))}
    </div>
  </section>
</MainLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const filterButtons = document.querySelectorAll('#category-filters button');
    const productCards = document.querySelectorAll('.product-card');

    filterButtons.forEach(button => {
      button.addEventListener('click', () => {
        const filterValue = button.getAttribute('data-filter');

        // 1. Update active button styling
        filterButtons.forEach(btn => {
          btn.classList.remove('bg-green-50', 'border-green-500', 'text-green-800');
          btn.classList.add('bg-white', 'text-gray-700', 'border-gray-200');
        });
        button.classList.remove('bg-white', 'text-gray-700', 'border-gray-200');
        button.classList.add('bg-green-50', 'border-green-500', 'text-green-800');

        // 2. Filter the Product Cards
        productCards.forEach(card => {
          const itemCategory = card.getAttribute('data-category');
          
          if (filterValue === 'all' || itemCategory === filterValue) {
            card.style.display = 'block';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  });
</script>