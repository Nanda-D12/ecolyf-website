---
import MainLayout from '../../layouts/MainLayout.astro';
// Assuming your new JSON is saved as catalog.json
import catalogData from '../../data/catalog.json'; 

// 1. DATA TRANSFORMATION: Flatten the nested JSON into an array of Product Families
const productFamilies = [];
Object.entries(catalogData).forEach(([categoryName, categoryFamilies]) => {
  Object.entries(categoryFamilies).forEach(([familyName, familyData]) => {
    productFamilies.push({
      category: categoryName,
      name: familyName,
      // Create a URL-safe slug (e.g., "Round Plates" -> "round-plates")
      slug: familyName.toLowerCase().replace(/\s+/g, '-'),
      data: familyData
    });
  });
});
---

<MainLayout 
  title="Enterprise Catalog | EcoLyf Exports" 
  description="Technical specifications for our 100% biodegradable bagasse product families."
>
  <div class="relative min-h-[350px] flex items-center overflow-hidden py-16 px-4 border-b border-brand-900 bg-brand-950">
    <img 
      src="/mobile-hero.webp" 
      alt="EcoLyf Production Lines" 
      class="absolute inset-0 w-full h-full object-cover mix-blend-overlay" 
    />
    <div class="absolute inset-0 bg-gradient-to-r from-brand-500/4 via-brand-500/2 to-transparent"></div>

    <div class="relative z-10 max-w-7xl mx-auto w-full">
      <div class="max-w-2xl">
        <h2 class="text-brand-400 font-extrabold tracking-widest uppercase text-[10px] mb-3">Institutional Supply</h2>
        <h1 class="text-4xl md:text-5xl font-black tracking-tight mb-4 text-white drop-shadow-md">
          Master <span class="text-brand-500">Catalog</span>
        </h1>
        <p class="text-base text-brand-200 max-w-lg leading-relaxed font-medium drop-shadow">
          Engineered for global distribution. Select a product family below to view complete SKU variations, technical specs, and shipping configurations.
        </p>
      </div>
    </div>
  </div>

  <section class="py-20 px-4 max-w-7xl mx-auto min-h-[60vh]">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      
      {productFamilies.map(family => (
        <a href={`/products/${family.slug}`} class="group block h-full">
          <div class="bg-white rounded-3xl overflow-hidden border border-brand-100 shadow-sm hover:shadow-2xl transition-all duration-500 hover:-translate-y-2 h-full flex flex-col relative">
            
            <div class="absolute top-4 left-4 z-20">
              <span class="bg-brand-950/80 backdrop-blur-md text-white text-[9px] font-bold px-3 py-1.5 rounded uppercase tracking-widest border border-brand-800">
                {family.category}
              </span>
            </div>

            <div class="h-64 sm:h-72 overflow-hidden relative bg-brand-50 flex items-center justify-center">
              <img 
                src={family.data.image} 
                alt={family.name} 
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                onerror="this.onerror=null; this.src='/images/placeholder.webp';"
              />
            </div>

            <div class="p-8 flex flex-col flex-grow border-t border-brand-50">
              <h3 class="text-2xl font-black text-brand-950 mb-2 tracking-tight">{family.name}</h3>
              
              <div class="text-[10px] font-bold uppercase tracking-widest text-brand-500 mb-6 pb-4 border-b border-brand-50 flex gap-4">
                <span>{family.data.Items.length} Sizes Available</span>
              </div>

              <ul class="space-y-3 mb-8 flex-grow">
                {family.data.Attributes.slice(0, 3).map(attr => (
                  <li class="flex items-center text-sm font-bold text-brand-800">
                    <div class="w-1.5 h-1.5 rounded-full bg-brand-500 mr-3 shrink-0"></div>
                    {attr}
                  </li>
                ))}
              </ul>

              <div class="flex items-center justify-between pt-4 border-t border-brand-50">
                <div>
                  <p class="text-[9px] uppercase tracking-widest font-bold text-brand-400 mb-0.5">Base MOQ</p>
                  <p class="text-sm font-black text-brand-950">{family.data.MOQ.toLocaleString()} pcs</p>
                </div>
                <div class="w-10 h-10 rounded-full bg-brand-50 flex items-center justify-center text-brand-600 group-hover:bg-brand-600 group-hover:text-white transition-colors duration-300">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                </div>
              </div>

            </div>
          </div>
        </a>
      ))}

    </div>
  </section>
</MainLayout>