---
import MainLayout from '../../layouts/MainLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import productsData from '../../data/products.json';
---

<MainLayout 
  title="Complete Catalog | EcoLyf Exports" 
  description="Browse our full range of export-quality bagasse tableware."
>
  <div class="relative min-h-[320px] flex items-center overflow-hidden py-16 px-4 border-b border-brand-900 bg-brand-950">
    <img 
      src="/mobile-hero.webp" 
      alt="EcoLyf Production" 
      class="absolute inset-0 w-full h-full object-cover opacity-20" 
    />
    
    <div class="absolute inset-0 bg-gradient-to-r from-brand-950 via-brand-950/80 to-transparent"></div>

    <div class="relative z-10 max-w-7xl mx-auto w-full">
      <div class="max-w-2xl">
        <div class="flex items-center gap-2 mb-4">
          <span class="w-2 h-2 bg-brand-500 rounded-full"></span>
          <span class="text-[10px] font-black text-brand-400 uppercase tracking-[0.3em]">Direct Manufacturer Supply</span>
        </div>
        <h1 class="text-4xl md:text-5xl font-black tracking-tight mb-4 text-white uppercase">
          Product <span class="text-brand-500">Catalog</span>
        </h1>
        <p class="text-base text-brand-200 max-w-lg leading-relaxed font-medium">
          Technical specifications for our 100% biodegradable bagasse range. Engineered for high-volume international distribution.
        </p>
      </div>
    </div>
  </div>

  <div class="bg-white border-b border-brand-100 sticky top-16 z-40 py-4 shadow-sm">
    <div class="max-w-7xl mx-auto px-4">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        
        <div class="flex items-center gap-2">
          <svg class="w-3 h-3 text-brand-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3"><path d="M3 4h18M6 10h12M9 16h6"></path></svg>
          <h3 class="text-[9px] font-black text-brand-500 uppercase tracking-[0.2em]">Procurement Filter</h3>
        </div>
        
        <div class="flex flex-wrap gap-2" id="category-filters">
          <button data-filter="all" class="filter-btn active-filter">
            All Units
          </button>

          <button data-filter="plates" class="filter-btn group">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><circle cx="12" cy="12" r="9"></circle></svg>
            Plates
          </button>

          <button data-filter="trays" class="filter-btn group">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><rect x="3" y="7" width="18" height="10" rx="2"></rect></svg>
            Trays
          </button>

          <button data-filter="bowls" class="filter-btn group">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path d="M4 9h16c0 4.418-3.582 8-8 8s-8-3.582-8-8z"></path></svg>
            Bowls
          </button>
        </div>
      </div>
    </div>
  </div>

  <section class="py-12 px-4 max-w-7xl mx-auto min-h-[60vh]">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="product-grid">
      {productsData.map(product => (
        <ProductCard product={product} />
      ))}
    </div>
  </section>
</MainLayout>

<style>
  @reference "../../styles/global.css"; 

  /* THE FIX: Enterprise Toggle Architecture */
  .filter-btn {
    /* Idle state: Clean, white, with a subtle border and brand-800 text */
    @apply bg-white border border-brand-200 px-4 py-2 rounded text-[11px] font-bold text-brand-800 transition-all duration-200 flex items-center cursor-pointer uppercase tracking-wider shadow-sm;
  }
  
  .filter-btn:hover:not(.active-filter) {
    /* Hover state: Gently shifts to the brand-50 tint to invite interaction */
    @apply border-brand-400 text-brand-700 bg-brand-50;
  }
  
  .active-filter {
    /* Active state: Looks like a solid, depressed toggle switch. No cheap rings. */
    @apply bg-brand-600 border-brand-600 text-white shadow-inner pointer-events-none;
  }
</style>

<script>
  function initProcurementFilters() {
    const filterBtns = document.querySelectorAll('.filter-btn');
    const productCards = document.querySelectorAll('.product-card');

    // Safety check: Exit if we aren't on the products page
    if (!filterBtns.length || !productCards.length) return;

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        
        // 1. The UI Update: Strip the active class from all buttons, apply to the clicked one
        filterBtns.forEach(b => b.classList.remove('active-filter'));
        btn.classList.add('active-filter');

        // 2. The Logic: Get the target category
        const targetCategory = btn.getAttribute('data-filter');

        // 3. The Execution: Loop through all cards and evaluate
        productCards.forEach(card => {
          const cardCategory = card.getAttribute('data-category');
          
          if (targetCategory === 'all' || targetCategory === cardCategory) {
            // Show the card
            (card as HTMLElement).style.display = 'block';
            
            // Optional: Force a reflow to restart CSS animations if you add them later
            void (card as HTMLElement).offsetWidth; 
            card.classList.remove('opacity-0', 'scale-95');
            card.classList.add('opacity-100', 'scale-100');
          } else {
            // Hide the card
            (card as HTMLElement).style.display = 'none';
            card.classList.remove('opacity-100', 'scale-100');
            card.classList.add('opacity-0', 'scale-95');
          }
        });
      });
    });
  }

  // Standard browser load
  document.addEventListener('DOMContentLoaded', initProcurementFilters);
  
  // Astro view transition support (prevents the script from dying on route changes)
  document.addEventListener('astro:page-load', initProcurementFilters);
</script>