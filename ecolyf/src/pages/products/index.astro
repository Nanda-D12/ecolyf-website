---
import MainLayout from '../../layouts/MainLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import productsData from '../../data/products.json';
---

<MainLayout 
  title="Complete Catalog | EcoLyf Exports" 
  description="Browse our full range of export-quality bagasse tableware."
>
  <div class="relative min-h-[320px] flex items-center overflow-hidden py-16 px-4 border-b border-gray-200 bg-gray-950">
    <img 
      src="/mobile-hero.webp" 
      alt="EcoLyf Production" 
      class="absolute inset-0 w-full h-full object-cover opacity-30 grayscale" 
    />
    
    <div class="absolute inset-0 bg-gradient-to-r from-gray-950 via-gray-950/70 to-transparent"></div>

    <div class="relative z-10 max-w-7xl mx-auto w-full">
      <div class="max-w-2xl">
        <div class="flex items-center gap-2 mb-4">
          <span class="w-2 h-2 bg-green-500 rounded-full"></span>
          <span class="text-[10px] font-bold text-green-500 uppercase tracking-[0.3em]">Direct Manufacturer Supply</span>
        </div>
        <h1 class="text-4xl md:text-5xl font-bold tracking-tight mb-4 text-white uppercase">
          Product <span class="text-green-500">Catalog</span>
        </h1>
        <p class="text-base text-gray-400 max-w-lg leading-relaxed font-medium">
          Technical specifications for our 100% biodegradable bagasse range. Engineered for high-volume international distribution.
        </p>
      </div>
    </div>
  </div>

  <div class="bg-white border-b border-gray-100 sticky top-16 z-40 py-4 shadow-sm">
    <div class="max-w-7xl mx-auto px-4">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div class="flex items-center gap-2">
          <svg class="w-3 h-3 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3"><path d="M3 4h18M6 10h12M9 16h6"></path></svg>
          <h3 class="text-[9px] font-black text-gray-400 uppercase tracking-[0.2em]">Procurement Filter</h3>
        </div>
        
        <div class="flex flex-wrap gap-2" id="category-filters">
          <button data-filter="all" class="filter-btn active-filter">
            All Units
          </button>

          <button data-filter="plates" class="filter-btn group">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><circle cx="12" cy="12" r="9"></circle></svg>
            Plates
          </button>

          <button data-filter="trays" class="filter-btn group">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><rect x="3" y="7" width="18" height="10" rx="2"></rect></svg>
            Trays
          </button>

          <button data-filter="bowls" class="filter-btn group">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path d="M4 9h16c0 4.418-3.582 8-8 8s-8-3.582-8-8z"></path></svg>
            Bowls
          </button>
        </div>
      </div>
    </div>
  </div>

  <section class="py-12 px-4 max-w-7xl mx-auto min-h-[60vh]">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="product-grid">
      {productsData.map(product => (
        <ProductCard product={product} />
      ))}
    </div>
  </section>
</MainLayout>

<style>
  @reference "../../styles/global.css"; 

  .filter-btn {
    @apply bg-gray-50 border border-gray-200 px-4 py-2 rounded-md text-[11px] font-bold text-gray-500 transition-all duration-200 hover:border-green-500 hover:text-green-600 flex items-center cursor-pointer uppercase tracking-wider;
  }
  
  .active-filter {
    @apply bg-white border-green-600 text-green-700 shadow-sm ring-1 ring-green-600;
  }
</style>