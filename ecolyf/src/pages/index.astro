---
import MainLayout from '../layouts/MainLayout.astro';
import Hero from '../components/Hero.astro';
import Logistics from '../components/Logistics.astro';
import OemSection from '../components/OemSection.astro';
import QuoteForm from '../components/QuoteForm.astro';
import Comparison from '../components/Comparison.astro';
import ImpactCalculator from '../components/ImpactCalculator.astro';
import FAQ from '../components/FAQ.astro';
import Contact from '../components/Contact.astro'; 
import WhyChooseUs from '../components/WhyChooseUs.astro';
import AboutUs from '../components/AboutUs.astro';
import Life from '../components/Life.astro';

// Native Astro optimized Image component
import { Image } from 'astro:assets';
import catalogData from '../data/catalog.json';

// Short-circuiting loop execution for optimized data collection
const featuredFamilies = [];
(() => {
  for (const [categoryName, categoryFamilies] of Object.entries(catalogData)) {
    for (const [familyName, familyData] of Object.entries(categoryFamilies)) {
      if (featuredFamilies.length >= 3) return;
      featuredFamilies.push({
        category: categoryName,
        name: familyName,
        slug: familyName.toLowerCase().replace(/\s+/g, '-'),
        data: familyData
      });
    }
  }
})();

// Defensive parsing helper
const getPillLabel = (item) => {
  if (!item || (!item.Volume && !item.Name && !item.Diameter)) return 'Standard';
  if (item.Volume) return item.Volume.split(' ')[0];
  if (item.Name?.includes('CP')) return item.Name.split(' ').slice(0, 2).join(' ');
  if (item.Name?.includes('x')) return item.Name.split(' ')[0];
  if (item.Diameter) return item.Diameter.split(' ')[0];
  return item.Name ? item.Name.split(' ')[0] : 'Item';
};
---

<MainLayout 
  title="EcoLyf | Sustainable Bagasse Tableware Manufacturer & Exporter" 
  description="Wholesale sugarcane bagasse tableware supplier. Certified biodegradable, compostable, and PFAS-free plates, bowls, and trays for global B2B markets."
>
  <Hero />
  <AboutUs />
  <WhyChooseUs />
  <Comparison />

  <section class="py-24 px-4 max-w-7xl mx-auto bg-white border-b border-brand-100">
    <div class="text-center mb-16">
      <h2 class="text-[10px] font-extrabold text-brand-500 tracking-[0.2em] uppercase mb-3">Export Catalog</h2>
      <h3 class="text-4xl md:text-5xl font-black text-brand-950 tracking-tight">Featured Export Products</h3>
      <p class="mt-4 text-sm md:text-base text-brand-800 max-w-2xl mx-auto font-medium leading-relaxed">
        Manufactured to strict international standards for restaurants, airlines, and institutional catering.
      </p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {featuredFamilies.map(family => (
        <a href={`/products/${family.slug}`} class="group block h-full">
          <div class="bg-white rounded-3xl overflow-hidden border border-brand-100 shadow-sm hover:shadow-2xl transition-all duration-500 hover:-translate-y-2 h-full flex flex-col relative">
            
            <div class="absolute top-4 left-4 z-20">
              <span class="bg-brand-950/80 backdrop-blur-md text-white text-[9px] font-bold px-3 py-1.5 rounded uppercase tracking-widest border border-brand-800">
                {family.category}
              </span>
            </div>

            <div class="h-64 sm:h-72 overflow-hidden relative bg-brand-50 flex items-center justify-center">
              <img 
                src={family.data.image || '/images/placeholder.webp'} 
                alt={family.name} 
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                loading="lazy"
              />
            </div>

            <div class="p-8 flex flex-col flex-grow border-t border-brand-50">
              <h3 class="text-2xl font-black text-brand-950 mb-2 tracking-tight">{family.name}</h3>
              
              <div class="text-[10px] font-bold uppercase tracking-widest text-brand-500 mb-3 flex gap-4">
                <span>{family.data.Items?.length || 0} Sizes Available</span>
              </div>

              <div class="flex flex-wrap gap-1.5 mb-6 pb-5 border-b border-brand-50">
                {family.data.Items?.map(item => (
                  <span class="bg-brand-100/60 border border-brand-200 text-brand-800 text-[10px] font-extrabold px-2 py-0.5 rounded shadow-sm tracking-tight">
                    {getPillLabel(item)}
                  </span>
                ))}
              </div>

              <div class="grid grid-cols-4 gap-2 mb-8 flex-grow content-start">
                {family.data.Attributes?.slice(0, 4).map(attr => (
                  <div class="bg-brand-50/70 rounded-xl p-2 flex flex-col items-center justify-center aspect-square group/tile hover:bg-brand-100 transition-colors duration-300">
                    <img 
                      src={`/icons/${attr.id}.png`} 
                      alt={attr.label}
                      class="w-6 h-6 sm:w-8 sm:h-8 object-contain mb-1.5 group-hover/tile:scale-110 transition-transform duration-300"
                    />
                    <span class="text-[8px] sm:text-[9px] font-black text-brand-950 leading-tight uppercase tracking-tight text-center line-clamp-2">
                      {attr.label}
                    </span>
                  </div>
                ))}
              </div>

              <div class="flex items-center justify-between pt-4 border-t border-brand-50">
                <div>
                  <p class="text-[9px] uppercase tracking-widest font-bold text-brand-400 mb-0.5">Base MOQ</p>
                  <p class="text-sm font-black text-brand-950">{family.data.MOQ ? family.data.MOQ.toLocaleString() : 0} pcs</p>
                </div>
                <div class="w-10 h-10 rounded-full bg-brand-50 flex items-center justify-center text-brand-600 group-hover:bg-brand-600 group-hover:text-white transition-colors duration-300">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                </div>
              </div>

            </div>
          </div>
        </a>
      ))}
    </div>

    <div class="text-center mt-16">
      <a href="/products" class="inline-flex items-center bg-white border border-brand-200 text-brand-800 font-black hover:bg-brand-600 hover:text-white hover:border-brand-600 shadow-sm hover:shadow transition-all duration-300 px-8 py-4 rounded-lg text-[11px] uppercase tracking-widest group">
        Explore Full Catalog 
        <svg class="w-4 h-4 ml-2 transform group-hover:translate-x-1 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
      </a>
    </div>
  </section>

  <OemSection />
  <Life />
  <ImpactCalculator />
  <Contact />

  <section id="quote" class="relative bg-brand-50 py-24 px-4 border-y border-brand-100 overflow-hidden">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-16 items-center relative z-10">
      <div class="relative flex flex-col items-center lg:items-start h-full justify-center min-h-[400px]">
        <div 
          class="absolute inset-0 w-full h-full bg-brand-500 opacity-20 pointer-events-none z-0"
          style="mask-image: url('/images/send.png'); mask-size: contain; mask-repeat: no-repeat; mask-position: center; -webkit-mask-image: url('/images/send.png'); -webkit-mask-size: contain; -webkit-mask-repeat: no-repeat; -webkit-mask-position: center;"
        ></div>

        <div class="relative z-10 w-full flex flex-col items-center lg:items-start text-center lg:text-left">
          <h2 class="text-4xl md:text-5xl font-black mb-4 tracking-tight text-brand-950 uppercase">Get in touch</h2>
          <div class="mb-12">
            <span class="bg-brand-600 px-3 py-1.5 rounded-full font-bold border border-brand-500 shadow-sm text-white text-xs uppercase tracking-wider">
              Response within 12 hours
            </span>
          </div>
          <div class="w-full max-w-sm h-64 drop-shadow-xl">
            <div 
              class="w-full h-full bg-brand-600"
              style="mask-image: url('/images/enquiry.png'); mask-size: contain; mask-repeat: no-repeat; mask-position: center; -webkit-mask-image: url('/images/enquiry.png'); -webkit-mask-size: contain; -webkit-mask-repeat: no-repeat; -webkit-mask-position: center;"
            ></div>
          </div>
        </div>
      </div>
      <div>
        <QuoteForm />
      </div>
    </div>
  </section>
</MainLayout>