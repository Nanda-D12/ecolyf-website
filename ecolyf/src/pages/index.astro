---
import MainLayout from '../layouts/MainLayout.astro';
import Hero from '../components/Hero.astro';
import Logistics from '../components/Logistics.astro';
import ProductCard from '../components/ProductCard.astro';
import OemSection from '../components/OemSection.astro';
import QuoteForm from '../components/QuoteForm.astro';
import Comparison from '../components/Comparison.astro';
import ImpactCalculator from '../components/ImpactCalculator.astro';
import FAQ from '../components/FAQ.astro';
import Contact from '../components/Contact.astro';

// Pulling directly from your new database
import productsData from '../data/products.json';
const featuredProducts = productsData.slice(0, 3); // Only show top 3 on homepage
---

<MainLayout 
  title="Manufacturer & Exporter of Eco-Friendly Bagasse" 
  description="Global export partner for 100% biodegradable bagasse plates, trays, and bowls."
>
  <Hero />

  <Comparison />

  <section class="py-24 px-4 max-w-7xl mx-auto">
    <div class="text-center mb-16">
      <h2 class="text-sm font-extrabold text-green-600 tracking-widest uppercase mb-2">Export Catalog</h2>
      <h3 class="text-4xl font-extrabold text-gray-900">High-Volume Export Products</h3>
      <p class="mt-4 text-xl text-gray-600 max-w-2xl mx-auto">Manufactured to strict international standards for restaurants, airlines, and institutional catering.</p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
      {featuredProducts.map(product => (
        <ProductCard product={product} />
      ))}
    </div>
    <div class="text-center mt-12">
      <a href="/products" class="inline-flex items-center text-green-700 font-bold hover:text-green-500 transition-colors duration-200 text-lg border-b-2 border-green-700 hover:border-green-500 pb-1 group">
        Explore Full Catalog 
        <svg class="w-5 h-5 ml-2 transform group-hover:translate-x-1 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
      </a>
    </div>
  </section>

  <OemSection />

  <ImpactCalculator />

  <Contact />

  <section id="quote" class="relative bg-gradient-to-br from-green-600 to-green-500 py-24 px-4 border-t-8 border-green-400 overflow-hidden">
    
    <div class="absolute top-0 left-0 w-full h-full overflow-hidden pointer-events-none z-0">
      <div class="absolute -top-40 -left-40 w-96 h-96 rounded-full bg-green-400 opacity-20 blur-3xl"></div>
      <div class="absolute bottom-0 right-1/2 w-64 h-64 rounded-full bg-green-700 opacity-30 blur-3xl"></div>
    </div>

    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-16 items-center relative z-10">
      
      <div class="text-white">
        <h2 class="text-4xl md:text-5xl font-extrabold mb-6 tracking-tight drop-shadow-sm">Ready to scale your supply?</h2>
        <p class="text-xl text-green-50 mb-8 leading-relaxed font-medium">
          Skip the middlemen. Buy directly from the manufacturer. Fill out the form to get our latest FOB/CIF pricing for 20ft and 40ft container loads. Our export team responds within <span class="bg-green-700/50 px-2 py-1 rounded font-bold border border-green-600/50 shadow-sm text-white">12 hours</span>.
        </p>
        
        <div class="space-y-4 bg-green-700/20 p-6 rounded-xl border border-green-500/30 backdrop-blur-sm shadow-inner">
          <p class="flex items-center text-green-100 text-lg"><strong class="text-white w-24 tracking-wide uppercase text-sm">Email:</strong> sales@EcoLyf.com</p>
          <p class="flex items-center text-green-100 text-lg"><strong class="text-white w-24 tracking-wide uppercase text-sm">HQ:</strong> Trichy, Tamil Nadu, India</p>
        </div>
      </div>
      
      <div>
        <QuoteForm />
      </div>
      
    </div>
  </section>
</MainLayout>