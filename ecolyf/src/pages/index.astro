---
import MainLayout from '../layouts/MainLayout.astro';
import Hero from '../components/Hero.astro';
import Logistics from '../components/Logistics.astro';
import ProductCard from '../components/ProductCard.astro';
import OemSection from '../components/OemSection.astro';
import QuoteForm from '../components/QuoteForm.astro';
import Comparison from '../components/Comparison.astro';
import ImpactCalculator from '../components/ImpactCalculator.astro';
import FAQ from '../components/FAQ.astro';
import Contact from '../components/Contact.astro'; // Assuming you renamed Contact to ContactSection based on previous code
import WhyChooseUs from '../components/WhyChooseUs.astro';
import AboutUs from '../components/AboutUs.astro';
import Life from '../components/Life.astro';

// Pulling directly from your new database
import productsData from '../data/products.json';
const featuredProducts = productsData.slice(0, 3); // Only show top 3 on homepage
---

<MainLayout 
  title="Manufacturer & Exporter of Eco-Friendly Bagasse" 
  description="Global export partner for 100% biodegradable bagasse plates, trays, and bowls."
>
  <Hero />
  <AboutUs />
  <WhyChooseUs />
  <Comparison />

  <section class="py-24 px-4 max-w-7xl mx-auto bg-white">
    <div class="text-center mb-16">
      <h2 class="text-sm font-extrabold text-brand-600 tracking-widest uppercase mb-2">Export Catalog</h2>
      <h3 class="text-4xl font-black text-brand-950">High-Volume Export Products</h3>
      <p class="mt-4 text-xl text-brand-800 max-w-2xl mx-auto font-medium">Manufactured to strict international standards for restaurants, airlines, and institutional catering.</p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
      {featuredProducts.map(product => (
        <ProductCard product={product} />
      ))}
    </div>
    <div class="text-center mt-12">
      <a href="/products" class="inline-flex items-center text-brand-600 font-bold hover:text-brand-700 transition-colors duration-200 text-lg border-b-2 border-brand-600 hover:border-brand-700 pb-1 group">
        Explore Full Catalog 
        <svg class="w-5 h-5 ml-2 transform group-hover:translate-x-1 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
      </a>
    </div>
  </section>

  <OemSection />

  <Life />

  <ImpactCalculator />

  <Contact />

  <section id="quote" class="relative bg-brand-50 py-24 px-4 border-y border-brand-100 overflow-hidden">
    
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-16 items-center relative z-10">
      
      <div class="text-black">
        <h2 class="text-4xl md:text-5xl font-black mb-6 tracking-tight drop-shadow-sm">Ready to scale your supply?</h2>
        <p class="text-xl text-brand-950 mb-8 leading-relaxed font-medium">
          Skip the middlemen. Buy directly from the manufacturer. Fill out the form to get our latest FOB/CIF pricing for 20ft and 40ft container loads. Our export team responds within 
          <span class="bg-brand-600 px-2 py-1 rounded font-bold border border-brand-500 shadow-sm text-white">12 hours</span>.
        </p>
        
        <div class="space-y-4 bg-brand-800 p-6 rounded-xl border border-brand-700 shadow-inner">
          <p class="flex items-center text-brand-50 text-lg">
            <strong class="text-brand-300 w-24 tracking-wide uppercase text-sm font-black">Email:</strong> 
            sales@ecolyf.com
          </p>
          <p class="flex items-center text-brand-50 text-lg">
            <strong class="text-brand-300 w-24 tracking-wide uppercase text-sm font-black">HQ:</strong> 
            Trichy, Tamil Nadu, India
          </p>
        </div>
      </div>
      
      <div>
        <QuoteForm />
      </div>
      
    </div>
  </section>
</MainLayout>