---
// src/pages/resources/[slug].astro
import { getCollection, render } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';

export async function getStaticPaths() {
  const resourcesEntries = await getCollection('resources', ({ data }) => {
    return data.draft !== true;
  });
  return resourcesEntries.map(entry => ({
    // Use entry.id instead of entry.slug
    params: { id: entry.id }, 
    props: { entry },
  }));
}

const { entry } = Astro.props;
// Use the new render() function instead of entry.render()
const { Content } = await render(entry);

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": entry.data.title,
  "description": entry.data.description,
  "author": {
    "@type": "Organization",
    "name": entry.data.author
  },
  "publisher": {
    "@type": "Organization",
    "name": "EcoLyf"
  },
  "datePublished": entry.data.publishDate.toISOString(),
  "audience": {
    "@type": "Audience",
    "audienceType": "B2B Procurement, Import Managers, Wholesale Distributors"
  }
};
---

<MainLayout title={`${entry.data.title} | EcoLyf Resources`} description={entry.data.description}>
  
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

  <article class="py-24 max-w-4xl mx-auto px-4">
    <div class="mb-12 border-b border-brand-100 pb-8 text-center">
      <div class="flex gap-2 justify-center mb-6">
        {entry.data.tags.map(tag => (
          <span class="bg-brand-50 text-brand-600 text-[10px] font-bold uppercase tracking-widest px-3 py-1 rounded border border-brand-200">{tag}</span>
        ))}
      </div>
      <h1 class="text-4xl md:text-5xl font-black text-brand-950 tracking-tight mb-6 leading-tight">{entry.data.title}</h1>
      <p class="text-brand-500 font-bold text-sm uppercase tracking-widest">Published by {entry.data.author}</p>
    </div>

    <div class="prose prose-brand lg:prose-lg mx-auto text-brand-800 marker:text-brand-600 prose-headings:font-black prose-headings:text-brand-950 prose-a:text-brand-600 prose-a:font-bold hover:prose-a:text-brand-800">
      <Content />
    </div>

    <div class="mt-16 bg-brand-950 rounded-2xl p-8 text-center border-t-4 border-brand-500 shadow-xl">
      <h3 class="text-2xl font-black text-white mb-4">Secure Your Supply Chain</h3>
      <p class="text-brand-200 mb-8 max-w-xl mx-auto">Stop gambling with unverified brokers. Work directly with an EN13432 certified manufacturer for your next FCL import.</p>
      <a href="/#quote" class="inline-block bg-white text-brand-950 font-black uppercase tracking-widest text-xs px-8 py-4 rounded hover:bg-brand-50 transition-colors">Request Master Compliance Packet</a>
    </div>
  </article>

</MainLayout>