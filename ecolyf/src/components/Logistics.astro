---
---
<section id="logistics" class="py-20 bg-white border-t border-gray-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-16">
      <h2 class="text-sm font-bold text-green-700 tracking-widest uppercase mb-2">Global Supply Chain</h2>
      <h3 class="text-4xl font-extrabold text-gray-900">Export Capabilities & Compliance</h3>
      <p class="mt-4 text-xl text-gray-600 max-w-2xl mx-auto">Seamless global logistics from our manufacturing facilities in Tamil Nadu to your nearest port.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 mb-16">
      <div class="bg-gray-50 p-8 rounded-xl border border-gray-200 hover:shadow-md transition-shadow">
        <div class="w-12 h-12 bg-green-100 text-green-700 rounded-lg flex items-center justify-center mb-6">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        </div>
        <h4 class="text-xl font-bold text-gray-900 mb-3">Shipping Terms</h4>
        <ul class="text-gray-600 space-y-2 font-medium">
          <li>• FOB (Tuticorin / Chennai)</li>
          <li>• CIF / CFR Available</li>
          <li>• LCL & FCL Shipments</li>
        </ul>
      </div>

      <div class="bg-gray-50 p-8 rounded-xl border border-gray-200 hover:shadow-md transition-shadow">
        <div class="w-12 h-12 bg-green-100 text-green-700 rounded-lg flex items-center justify-center mb-6">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path></svg>
        </div>
        <h4 class="text-xl font-bold text-gray-900 mb-3">Order Volumes</h4>
        <ul class="text-gray-600 space-y-2 font-medium">
          <li>• MOQ: 50,000 Pieces</li>
          <li>• 20ft Container (approx. 300 cartons)</li>
          <li>• 40ft HQ (approx. 750 cartons)</li>
        </ul>
      </div>

      <div class="bg-gray-50 p-8 rounded-xl border border-gray-200 hover:shadow-md transition-shadow">
        <div class="w-12 h-12 bg-green-100 text-green-700 rounded-lg flex items-center justify-center mb-6">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        </div>
        <h4 class="text-xl font-bold text-gray-900 mb-3">Production Lead Time</h4>
        <ul class="text-gray-600 space-y-2 font-medium">
          <li>• Standard Catalog: 15-20 Days</li>
          <li>• Custom OEM: 25-30 Days</li>
          <li>• Sample Dispatch: 3-5 Days</li>
        </ul>
      </div>

      <div class="bg-gray-50 p-8 rounded-xl border border-gray-200 hover:shadow-md transition-shadow">
        <div class="w-12 h-12 bg-green-100 text-green-700 rounded-lg flex items-center justify-center mb-6">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
        </div>
        <h4 class="text-xl font-bold text-gray-900 mb-3">Certifications</h4>
        <ul class="text-gray-600 space-y-2 font-medium">
          <li>• SGS Tested</li>
          <li>• ISO 9001:2015</li>
          <li>• 100% Compostable (EN 13432)</li>
        </ul>
      </div>
    </div>
    
  </div>
</section>