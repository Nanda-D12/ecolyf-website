---
const faqs = [
  {
    question: "Are your bagasse products EN13432 certified for European import?",
    answer: "Yes. As a direct manufacturer, all EcoLyf bagasse packaging is strictly EN13432 and TUV OK Compost Industrial certified. We provide full compliance documentation, including PFAS-free testing reports, directly to your procurement and customs teams to ensure seamless EU and global import."
  },
  {
    question: "What is the advantage of buying direct from the manufacturer vs a local wholesaler?",
    answer: "By bypassing regional importers and buying direct from EcoLyf's manufacturing facility, enterprise buyers save 30-40% on unit costs. We offer direct-to-port container shipping (FCL), custom OEM branding, and guaranteed supply chain stability without middleman markups."
  },
  {
    question: "What are your minimum order quantities (MOQ) for international container shipping?",
    answer: "Our standard MOQ for direct export is 50,000 pieces per SKU, optimized for 20ft and 40ft container loadability. We offer consolidated shipments combining multiple product families (plates, bowls, clamshells) to maximize your freight efficiency."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<section id="faq" class="py-24 bg-white border-y border-brand-100">
  <div class="max-w-4xl mx-auto px-4">
    
    <div class="text-center mb-16">
      <h2 class="text-[10px] font-extrabold text-brand-500 tracking-[0.2em] uppercase mb-3">Global Procurement</h2>
      <h3 class="text-3xl md:text-4xl font-black text-brand-950 tracking-tight">B2B Export FAQ</h3>
    </div>

    <div class="space-y-6">
      {faqs.map(faq => (
        <div class="bg-brand-50 rounded-xl p-6 md:p-8 border border-brand-100 shadow-sm">
          <h4 class="text-lg font-black text-brand-900 mb-3 flex items-start gap-3">
            <svg class="w-6 h-6 text-brand-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            {faq.question}
          </h4>
          <p class="text-brand-700 leading-relaxed ml-9 font-medium">
            {faq.answer}
          </p>
        </div>
      ))}
    </div>

  </div>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</section>