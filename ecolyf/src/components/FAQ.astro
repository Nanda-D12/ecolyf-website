---
const faqs = [
  {
    q: "What is your Minimum Order Quantity (MOQ)?",
    a: "Our standard MOQ for international export is 50,000 pieces per SKU. This typically equates to a mixed 20ft container load."
  },
  {
    q: "Do you offer custom OEM and private labeling?",
    a: "Yes. We can emboss your corporate logo directly onto the bagasse tooling, and provide custom printed inner sleeves and outer export cartons."
  },
  {
    q: "What certifications do your products hold?",
    a: "Our tableware is SGS tested, FDA compliant for food contact, and meets EN 13432 standards for commercial compostability."
  },
  {
    q: "What Incoterms do you support?",
    a: "We primarily quote FOB (Tuticorin/Chennai). However, our logistics team can provide CIF or CFR pricing to your destination port upon request."
  }
];
---
<section class="py-24 bg-white">
  <div class="max-w-4xl mx-auto px-4">
    <div class="text-center mb-16">
      <h2 class="text-3xl font-extrabold text-gray-900 mb-4">Export Logistics FAQ</h2>
      <p class="text-gray-600">Common questions regarding our manufacturing capacity and global shipping protocols.</p>
    </div>

    <div class="space-y-6">
      {faqs.map(faq => (
        <div class="border border-gray-200 rounded-lg p-6 hover:shadow-md transition-shadow bg-gray-50">
          <h4 class="text-lg font-bold text-gray-900 mb-2 flex items-start">
            <svg class="w-6 h-6 text-green-600 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            {faq.q}
          </h4>
          <p class="text-gray-600 ml-8">{faq.a}</p>
        </div>
      ))}
    </div>
  </div>
</section>