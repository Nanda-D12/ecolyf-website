---
// src/components/ComparisonSection.astro
---
<section class="py-24 bg-white border-y border-brand-100 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-16">
      <h2 class="text-sm font-extrabold text-brand-600 tracking-widest uppercase mb-3">Material Integrity</h2>
      <h3 class="text-4xl md:text-5xl font-black text-brand-950 mb-6 leading-tight tracking-tight">
        The Future of Global Supply.
      </h3>
      <p class="text-lg text-brand-800 max-w-2xl mx-auto font-medium">
        Why international distributors are aggressively migrating away from legacy plastics toward institutional-grade bagasse.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      
      <div class="relative w-full min-h-[550px] md:min-h-[650px] rounded-3xl overflow-hidden flex items-center justify-center p-6 group">
        <div class="absolute inset-0 z-0">
          <img src="/images/plastic-bg.webp" alt="Plastic Waste" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
          <div class="absolute inset-0 bg-brand-950/10 backdrop-brightness-90"></div>
        </div>
        
        <div class="relative z-10 w-full max-w-sm backdrop-blur-l bg-white/80 p-8 rounded-2xl border border-white/50 shadow-2xl transition-transform duration-500 md:group-hover:-translate-y-2">
          <div class="flex items-center justify-between mb-6 border-b border-brand-100 pb-4">
            <h4 class="text-xl font-black text-brand-950">Standard Plastic</h4>
            <span class="text-[10px] uppercase tracking-widest font-bold bg-orange-50 border border-orange-200 text-orange-600 px-3 py-1 rounded-full shadow-sm">
              High Risk
            </span>
          </div>
          
          <ul class="space-y-4 text-sm text-brand-900 font-bold">
            <li class="flex items-start">
              <svg class="w-5 h-5 text-orange-500 mr-3 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
              High global import tariffs
            </li>
            <li class="flex items-start">
              <svg class="w-5 h-5 text-orange-500 mr-3 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
              Leaves toxic microplastics
            </li>
            <li class="flex items-start">
              <svg class="w-5 h-5 text-orange-500 mr-3 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
              Rejects circular economy goals
            </li>
          </ul>
        </div>
      </div>

      <div class="relative w-full min-h-[550px] md:min-h-[650px] rounded-3xl overflow-hidden flex items-center justify-center p-6 group">
        <div class="absolute inset-0 z-0">
          <img src="/images/styrofoam-bg.webp" alt="Styrofoam Impact" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
          <div class="absolute inset-0 bg-brand-950/10 backdrop-brightness-90"></div>
        </div>
        
        <div class="relative z-10 w-full max-w-sm backdrop-blur-l bg-white/80 p-8 rounded-2xl border border-white/50 shadow-2xl transition-transform duration-500 md:group-hover:-translate-y-2">
          <div class="flex items-center justify-between mb-6 border-b border-brand-100 pb-4">
            <h4 class="text-xl font-black text-brand-950">Styrofoam (EPS)</h4>
            <span class="text-[10px] uppercase tracking-widest font-bold bg-red-50 border border-red-200 text-red-600 px-3 py-1 rounded-full shadow-sm">
              Outdated
            </span>
          </div>
          
          <ul class="space-y-4 text-sm text-brand-900 font-bold">
            <li class="flex items-start">
              <svg class="w-5 h-5 text-red-500 mr-3 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
              Takes 500+ years to degrade
            </li>
            <li class="flex items-start">
              <svg class="w-5 h-5 text-red-500 mr-3 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
              Leaches toxins when heated
            </li>
            <li class="flex items-start">
              <svg class="w-5 h-5 text-red-500 mr-3 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
              Facing immediate global bans
            </li>
          </ul>
        </div>
      </div>

      <div class="relative w-full min-h-[550px] md:min-h-[650px] rounded-3xl overflow-hidden flex items-center justify-center p-6 group ring-4 ring-brand-500 ring-offset-4 ring-offset-white lg:-translate-y-4">
        <div class="absolute inset-0 z-0">
          <img src="/images/bagasse-bg.jpg" alt="EcoLyf Bagasse Tableware" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
          <div class="absolute inset-0 bg-brand-950/10 backdrop-brightness-95"></div>
        </div>
        
        <div class="relative z-10 w-full max-w-sm backdrop-blur-l bg-brand-600/90 p-8 rounded-2xl border border-brand-600 shadow-2xl transition-transform duration-500 md:group-hover:-translate-y-2">
          
          <div class="absolute -top-4 right-6 bg-white text-brand-600 text-[9px] font-black uppercase tracking-[0.2em] px-4 py-1.5 rounded-full shadow-lg border border-brand-500">
            Export Standard
          </div>

          <div class="flex items-center justify-between mb-6 border-b border-brand-100 pb-4 mt-2">
            <h4 class="text-xl font-white text-white font-bold">Sugarcane Bagasse</h4>
            <span class="text-[10px] uppercase tracking-widest font-bold bg-brand-50 border border-brand-200 text-brand-600 px-3 py-1 rounded-full shadow-sm">
              EcoLyf
            </span>
          </div>
          
          <ul class="space-y-4 text-sm text-white font-bold">
            <li class="flex items-start">
              <div class="w-5 h-5 rounded-full bg-brand-100 text-brand-600 flex items-center justify-center mr-3 shrink-0 mt-0.5">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="4"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
              </div>
              100% Compostable (90 Days)
            </li>
            <li class="flex items-start">
              <div class="w-5 h-5 rounded-full bg-brand-100 text-brand-600 flex items-center justify-center mr-3 shrink-0 mt-0.5">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="4"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
              </div>
              Non-toxic, PFAS-free design
            </li>
            <li class="flex items-start">
              <div class="w-5 h-5 rounded-full bg-brand-100 text-brand-600 flex items-center justify-center mr-3 shrink-0 mt-0.5">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="4"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
              </div>
              Global Customs / SGS Compliant
            </li>
          </ul>
        </div>
      </div>

    </div>
  </div>
</section>