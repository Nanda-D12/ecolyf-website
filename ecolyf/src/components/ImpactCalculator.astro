---
// src/components/ImpactCalculator.astro
---
<section class="py-16 relative overflow-hidden border-y border-brand-900">

  <div class="absolute inset-0 z-0">
    <img 
      src="/images/calc-bg.webp" 
      alt="Sustainability Forest" 
      class="w-full h-full object-cover" 
    />
    <div class="absolute inset-0 bg-gradient-to-b from-brand-950/10 via-transparent to-brand-950/10"></div>
  </div>

  <div class="max-w-5xl mx-auto px-4 relative z-10">
    
    <div class="backdrop-blur-2xl bg-white/80 border border-white/50 rounded-3xl shadow-2xl overflow-hidden text-brand-950">
      
      <div class="bg-white/40 border-b border-brand-100/50 p-8 md:p-10 text-center">
        <h2 class="text-brand-600 font-extrabold tracking-widest uppercase text-sm mb-2">Data-Driven Sustainability</h2>
        <h3 class="text-3xl md:text-4xl font-black mb-4 tracking-tight text-brand-950">Calculate Your Impact</h3>
        <p class="text-base text-brand-800 max-w-2xl mx-auto font-medium lead-relaxed">
          See the exact environmental footprint your company erases by switching to EcoLyf Bagasse for your monthly tableware volume.
        </p>
      </div>
      
      <div class="p-8 md:p-10 pt-0 md:pt-0 grid grid-cols-1 md:grid-cols-2 gap-8">
        
        <div class="space-y-6 flex flex-col justify-center">
          <div>
            <div class="flex justify-between items-end mb-2">
              <label class="block text-base font-black text-brand-950">Monthly Volume</label>
              <div class="text-right font-black text-2xl text-brand-600" id="val-volume">100,000</div>
            </div>
            <input type="range" id="calc-volume" min="10000" max="1000000" step="10000" value="100000" class="w-full h-2.5 bg-brand-100/80 rounded-lg appearance-none cursor-pointer accent-brand-600 hover:accent-brand-700 transition-all">
            <div class="flex justify-between text-[10px] font-bold text-brand-500 mt-2 uppercase tracking-wider">
              <span>10k Pieces</span>
              <span>1M+ Pieces</span>
            </div>
          </div>

          <div>
            <label class="block text-base font-black text-brand-950 mb-2">Material to Replace</label>
            <select id="calc-material" class="w-full bg-white/60 border-2 border-brand-100 text-brand-950 text-base font-bold rounded-xl focus:ring-0 focus:border-brand-500 block p-3 transition-colors cursor-pointer hover:border-brand-300 shadow-sm">
              <option value="plastic">Standard Plastic</option>
              <option value="styrofoam">Styrofoam (EPS)</option>
            </select>
          </div>
        </div>

        <div class="bg-white/50 rounded-2xl p-6 border border-white/60 flex flex-col justify-center space-y-5 shadow-inner">
          
          <div class="flex items-center group">
            <div class="bg-white p-2.5 rounded-lg shadow-sm border border-brand-100 mr-4 text-brand-700 group-hover:scale-105 group-hover:bg-brand-600 group-hover:text-white transition-all duration-300 shrink-0">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
            </div>
            <div>
              <p class="text-[10px] font-bold text-brand-600 uppercase tracking-widest mb-0.5">Toxic Material Diverted</p>
              <p class="text-2xl font-black text-brand-950 tracking-tight leading-none" id="out-plastic">1,500 kg</p>
            </div>
          </div>

          <div class="flex items-center group">
            <div class="bg-white p-2.5 rounded-lg shadow-sm border border-brand-100 mr-4 text-brand-700 group-hover:scale-105 group-hover:bg-brand-600 group-hover:text-white transition-all duration-300 shrink-0">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"></path></svg>
            </div>
            <div>
              <p class="text-[10px] font-bold text-brand-600 uppercase tracking-widest mb-0.5">CO₂ Emissions Saved</p>
              <p class="text-2xl font-black text-brand-950 tracking-tight leading-none" id="out-co2">9.00 Tonnes</p>
            </div>
          </div>

          <div class="flex items-center group">
            <div class="bg-white p-2.5 rounded-lg shadow-sm border border-brand-100 mr-4 text-brand-700 group-hover:scale-105 group-hover:bg-brand-600 group-hover:text-white transition-all duration-300 shrink-0">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"></path></svg>
            </div>
            <div>
              <p class="text-[10px] font-bold text-brand-600 uppercase tracking-widest mb-0.5">Equivalent Trees Planted</p>
              <p class="text-2xl font-black text-brand-950 tracking-tight leading-none" id="out-trees">428 Trees</p>
            </div>
          </div>

        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function initCalculator() {
    const volSlider = document.getElementById('calc-volume');
    const matSelect = document.getElementById('calc-material');
    const valDisplay = document.getElementById('val-volume');
    
    const outPlastic = document.getElementById('out-plastic');
    const outCo2 = document.getElementById('out-co2');
    const outTrees = document.getElementById('out-trees');

    if (!volSlider || !matSelect) return;

    function calculate() {
      const volume = parseInt((volSlider as HTMLInputElement).value);
      const material = (matSelect as HTMLSelectElement).value;
      
      if (valDisplay) valDisplay.textContent = volume.toLocaleString();

      const weightKg = volume * 0.015;
      const co2Multiplier = material === 'styrofoam' ? 8.5 : 6.0;
      const totalCo2 = weightKg * co2Multiplier;
      const trees = Math.round(totalCo2 / 21);

      if (outPlastic) outPlastic.textContent = weightKg.toLocaleString() + ' kg';
      if (outCo2) outCo2.textContent = (totalCo2 / 1000).toFixed(2) + ' Tonnes';
      if (outTrees) outTrees.textContent = trees.toLocaleString() + ' Trees';
    }

    volSlider.addEventListener('input', calculate);
    matSelect.addEventListener('change', calculate);
    
    calculate();
  }

  document.addEventListener('DOMContentLoaded', initCalculator);
  document.addEventListener('astro:page-load', initCalculator);
</script>