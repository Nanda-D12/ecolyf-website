---
// src/components/WhatsAppButton.astro

const phoneNumber = "918608503282"; 
const defaultMessage = "Hello EcoLyf team, I am interested in export pricing for bagasse tableware.";
const whatsappUrl = `https://wa.me/${phoneNumber}?text=${encodeURIComponent(defaultMessage)}`;
---

<div class="fixed bottom-6 right-6 z-50">
  
  <div 
    id="wa-popup" 
    class="absolute bottom-20 right-0 mb-4 w-[320px] max-h-[80vh] bg-[#E5DDD5] rounded-2xl shadow-2xl overflow-hidden origin-bottom-right transition-all duration-300 scale-0 opacity-0 pointer-events-none flex flex-col"
    aria-hidden="true"
  >
    <div class="bg-[#128C7E] p-4 flex items-center justify-between shadow-md z-10 shrink-0">
      <div class="flex items-center gap-3 min-w-0">
        <div class="w-10 h-10 bg-white rounded-full flex items-center justify-center p-1.5 shadow-sm shrink-0 overflow-hidden">
          <img src="/EcoLyfLogo.png" alt="EcoLyf" class="w-full h-full object-contain" />
        </div>
        <div class="min-w-0">
          <h4 class="text-white font-bold text-sm truncate">EcoLyf Export Sales</h4>
          <p class="text-white/90 text-[10px] flex items-center gap-1">
            <span class="w-1.5 h-1.5 bg-[#25D366] rounded-full inline-block shrink-0"></span>
            Typically replies instantly
          </p>
        </div>
      </div>
      <button id="wa-close" class="text-white/70 hover:text-white transition-colors p-1 shrink-0 ml-2" aria-label="Close Chat">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
      </button>
    </div>

    <div class="p-4 flex-grow flex flex-col gap-3 relative overflow-y-auto h-[250px]">
      <div class="absolute inset-0 opacity-[0.03] pointer-events-none" style="background-image: url('data:image/svg+xml,%3Csvg width=\'20\' height=\'20\' viewBox=\'0 0 20 20\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cg fill=\'%23000000\' fill-opacity=\'1\' fill-rule=\'evenodd\'%3E%3Ccircle cx=\'3\' cy=\'3\' r=\'3\'/%3E%3Ccircle cx=\'13\' cy=\'13\' r=\'3\'/%3E%3C/g%3E%3C/svg%3E');"></div>
      
      <div class="bg-white p-3 rounded-lg rounded-tl-none shadow-sm text-sm text-gray-800 self-start max-w-[85%] relative z-10">
        <p class="font-medium">Welcome to EcoLyf! 👋</p>
        <p class="mt-1">How can we help you with your international export requirements today?</p>
        <span class="text-[9px] text-gray-400 absolute bottom-1 right-2">Just now</span>
      </div>
    </div>

    <div class="bg-[#F0F0F0] p-3 flex items-center gap-2 shrink-0">
      <input 
        type="text" 
        id="wa-input" 
        placeholder="Send a message..." 
        autocomplete="off"
        class="bg-white rounded-full px-4 py-2.5 flex-grow shadow-sm border border-gray-200 min-w-0 text-[13px] text-gray-700 focus:outline-none focus:border-[#128C7E] focus:ring-1 focus:ring-[#128C7E] transition-all pointer-events-auto"
      />
      
      <a 
        id="wa-send-btn"
        href={whatsappUrl} 
        target="_blank" 
        rel="noopener noreferrer"
        data-phone={phoneNumber}
        data-default-msg={defaultMessage}
        class="w-10 h-10 bg-[#128C7E] rounded-full flex items-center justify-center text-white shadow-sm hover:bg-[#075E54] hover:scale-105 transition-all shrink-0 pointer-events-auto"
        aria-label="Send message to WhatsApp"
      >
        <svg class="w-5 h-5 ml-1" fill="currentColor" viewBox="0 0 24 24"><path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"></path></svg>
      </a>
    </div>
  </div>

  <button 
    id="wa-trigger"
    aria-label="Open WhatsApp Chat"
    class="w-16 h-16 bg-[#25D366] text-white rounded-full flex items-center justify-center shadow-lg hover:shadow-2xl hover:scale-105 transition-all duration-300 relative group z-20 pointer-events-auto"
  >
    <div class="absolute -top-1 -right-1 flex h-5 w-5">
      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
      <span class="relative inline-flex rounded-full h-5 w-5 bg-red-500 border-2 border-white items-center justify-center text-[10px] font-bold text-white">1</span>
    </div>

    <svg class="w-9 h-9" fill="currentColor" viewBox="0 0 24 24">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
    </svg>
  </button>
</div>

<script>
  function initWhatsAppWidget() {
    const trigger = document.getElementById('wa-trigger');
    const popup = document.getElementById('wa-popup');
    const closeBtn = document.getElementById('wa-close');
    const waInput = document.getElementById('wa-input') as HTMLInputElement;
    const waSendBtn = document.getElementById('wa-send-btn') as HTMLAnchorElement;

    if (!trigger || !popup || !closeBtn) return;

    // Toggle logic
    trigger.addEventListener('click', () => {
      const isClosed = popup.classList.contains('scale-0');
      if (isClosed) {
        popup.classList.remove('scale-0', 'opacity-0', 'pointer-events-none');
        popup.classList.add('scale-100', 'opacity-100', 'pointer-events-auto');
        const badge = trigger.querySelector('.absolute.-top-1');
        if (badge) badge.classList.add('hidden');
        
        // Auto-focus the input field when opened on desktop
        if (window.innerWidth > 768 && waInput) {
          setTimeout(() => waInput.focus(), 300);
        }
      } else {
        popup.classList.remove('scale-100', 'opacity-100', 'pointer-events-auto');
        popup.classList.add('scale-0', 'opacity-0', 'pointer-events-none');
      }
    });

    closeBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      popup.classList.remove('scale-100', 'opacity-100', 'pointer-events-auto');
      popup.classList.add('scale-0', 'opacity-0', 'pointer-events-none');
    });

    // THE UX FIX: Real-time payload binding
    if (waInput && waSendBtn) {
      // 1. Update the WhatsApp URL dynamically as the user types
      waInput.addEventListener('input', (e) => {
        const target = e.target as HTMLInputElement;
        const phone = waSendBtn.getAttribute('data-phone');
        const defaultMsg = waSendBtn.getAttribute('data-default-msg');
        const customText = target.value.trim();
        
        const textToEncode = customText ? customText : defaultMsg;
        waSendBtn.href = `https://wa.me/${phone}?text=${encodeURIComponent(textToEncode)}`;
      });

      // 2. Allow the user to press "Enter" to send the message
      waInput.addEventListener('keypress', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          waSendBtn.click();
        }
      });
    }
  }

  document.addEventListener('DOMContentLoaded', initWhatsAppWidget);
  document.addEventListener('astro:page-load', initWhatsAppWidget);
</script>