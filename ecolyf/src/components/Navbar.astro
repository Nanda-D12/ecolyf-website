---
// Navbar.astro
---
<header class="bg-white/90 backdrop-blur-md border-b border-green-100 sticky top-0 z-50 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between h-20 items-center">
      
      <div class="flex-shrink-0 flex items-center">
        <a href="/" class="text-3xl font-black text-gray-900 tracking-tighter group">
          Eco<span class="text-green-500 group-hover:text-green-400 transition-colors">Lyf</span>
        </a>
      </div>

      <nav class="hidden md:flex items-center space-x-8">
        
        <a href="/" class="text-gray-700 hover:text-brand-700 font-medium transition">HOME</a>

        <a href="/products" class="text-gray-600 hover:text-green-600 font-bold transition-colors duration-200 text-sm uppercase tracking-wide">
          Products
        </a>
        
        <a href="/files/ecolyf-catalogue.pdf" download="EcoLyf_Catalogue.pdf" class="text-gray-600 hover:text-green-600 font-bold transition-colors duration-200 text-sm uppercase tracking-wide group flex items-center gap-1">
          Catalogue
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-gray-400 group-hover:text-green-500 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
        </a>
        
        <a href="/#contact" class="text-gray-600 hover:text-green-600 font-bold transition-colors duration-200 text-sm uppercase tracking-wide">
          Contact Us
        </a>
        
        <a href="/#quote" class="bg-brand-500 text-white font-bold py-2.5 px-6 rounded shadow-[0_4px_14px_0_rgba(34,197,94,0.39)] hover:shadow-[0_6px_20px_rgba(34,197,94,0.23)] hover:scale-[1.02] transition-all duration-200 flex items-center gap-2">
          Enquiry
        </a>
      </nav>

      <div class="md:hidden flex items-center">
        <button class="text-gray-600 hover:text-green-600 focus:outline-none">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
      
    </div>
  </div>
</header>