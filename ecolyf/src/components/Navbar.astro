---
// Navbar.astro
---
<header class="bg-white/95 backdrop-blur-md border-b border-brand-100 sticky top-0 z-50 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="flex justify-between h-20 items-center">
      
      <div class="flex-shrink-0 flex items-center h-20 py-1.5">
        <a href="/" class="group flex items-center h-full">
          <img 
            src="/EcoLyfLogo.png" 
            alt="EcoLyf Logo" 
            class="h-full w-auto object-contain origin-left transition-transform duration-300 group-hover:scale-[1.03]" 
          />
        </a>
      </div>

      <nav class="hidden md:flex items-center space-x-8">
        <a href="/" class="text-brand-800 hover:text-brand-600 font-bold transition-colors text-sm uppercase tracking-wide">Home</a>
        <a href="/products" class="text-brand-800 hover:text-brand-600 font-bold transition-colors text-sm uppercase tracking-wide">Products</a>
        <a href="/files/ecolyf-catalogue.pdf" download class="text-brand-800 hover:text-brand-600 font-bold transition-colors text-sm uppercase tracking-wide group flex items-center gap-1">
          Catalogue
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-brand-400 group-hover:text-brand-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
        </a>
        <a href="/#about" class="text-brand-800 hover:text-brand-600 font-bold transition-colors text-sm uppercase tracking-wide">About Us</a>
        <a href="/#contact" class="text-brand-800 hover:text-brand-600 font-bold transition-colors text-sm uppercase tracking-wide">Contact Us</a>
        
        <a href="/#quote" class="bg-brand-600 text-white font-bold py-2.5 px-6 rounded shadow-sm hover:bg-brand-700 transition-all flex items-center gap-2">
          Enquiry
        </a>
      </nav>

      <div class="md:hidden flex items-center">
        <button id="menu-toggle" class="text-brand-800 hover:text-brand-600 focus:outline-none p-2" aria-label="Toggle Menu">
          <svg id="menu-icon" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <div id="mobile-menu" class="hidden md:hidden bg-white border-b border-brand-100 absolute w-full left-0 shadow-xl animate-in slide-in-from-top duration-300">
    <div class="px-4 pt-2 pb-6 space-y-2">
      <a href="/products" class="block px-4 py-3 text-base font-bold text-brand-950 hover:bg-brand-50 hover:text-brand-600 rounded uppercase">Products</a>
      <a href="/files/ecolyf-catalogue.pdf" download class="block px-4 py-3 text-base font-bold text-brand-950 hover:bg-brand-50 hover:text-brand-600 rounded uppercase">Catalogue</a>
      <a href="/#about" class="block px-4 py-3 text-base font-bold text-brand-950 hover:bg-brand-50 hover:text-brand-600 rounded uppercase">About Us</a>
      <a href="/#contact" class="block px-4 py-3 text-base font-bold text-brand-950 hover:bg-brand-50 hover:text-brand-600 rounded uppercase">Contact Us</a>
      <div class="pt-4 px-4">
        <a href="/#quote" class="block w-full text-center bg-brand-600 text-white font-bold py-4 rounded shadow-sm hover:bg-brand-700 transition-colors uppercase">
          Enquiry
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const setupNav = () => {
    const menuToggle = document.getElementById('menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const menuLinks = mobileMenu?.querySelectorAll('a');

    if (menuToggle && mobileMenu) {
      menuToggle.addEventListener('click', () => {
        mobileMenu.classList.toggle('hidden');
      });

      menuLinks?.forEach(link => {
        link.addEventListener('click', () => {
          mobileMenu.classList.add('hidden');
        });
      });
    }
  };

  setupNav();
  document.addEventListener('astro:after-swap', setupNav);
</script>