---

<div class="max-w-2xl mx-auto bg-white p-8 rounded-lg shadow-md border border-gray-100">
  <h2 class="text-3xl font-bold text-green-800 mb-6 text-center">Request a Bulk Quote</h2>
  <p class="text-gray-600 text-center mb-8">Fill out your details and our export team will contact you within 24 hours.</p>

  <form class="space-y-6" action="#" method="POST">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <label for="name" class="block text-sm font-medium text-gray-700">Full Name / Company</label>
        <input type="text" id="name" name="name" required class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-green-500 focus:ring-green-500 p-2 border" />
      </div>
      <div>
        <label for="email" class="block text-sm font-medium text-gray-700">Email Address</label>
        <input type="email" id="email" name="email" required class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-green-500 focus:ring-green-500 p-2 border" />
      </div>
    </div>

    <div>
      <label for="product" class="block text-sm font-medium text-gray-700">Product of Interest</label>
      <select id="product" name="product" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-green-500 focus:ring-green-500 p-2 border bg-white">
        <option>10-inch Bagasse Round Plate</option>
        <option>Compartment Meal Tray</option>
        <option>6-inch Dessert Plate</option>
        <option>Multiple / Full Catalog</option>
      </select>
    </div>

    <div>
      <label for="quantity" class="block text-sm font-medium text-gray-700">Estimated Monthly Volume (Pieces)</label>
      <input type="text" id="quantity" name="quantity" placeholder="e.g., 50,000" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-green-500 focus:ring-green-500 p-2 border" />
    </div>

    <button type="submit" class="w-full bg-green-700 text-white font-bold py-3 px-4 rounded hover:bg-green-800 transition-colors duration-200">
      Submit Request
    </button>
  </form>
</div>