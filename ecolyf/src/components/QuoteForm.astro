---
// src/components/QuoteForm.astro

// Replace these with your actual EmailJS keys
const EMAILJS_SERVICE_ID = "service_mzc2q37";
const EMAILJS_TEMPLATE_ID = "template_56jv7fk";
const EMAILJS_PUBLIC_KEY = "xjwmtAjXnI-QXf0gJ";
---

<div class="max-w-2xl mx-auto bg-white p-6 md:p-8 rounded-xl shadow-[0_8px_30px_rgb(0,0,0,0.08)] border-t-4 border-t-brand-500 relative overflow-hidden">
  
  <div class="absolute -top-24 -right-24 w-48 h-48 rounded-full bg-gradient-to-br from-brand-400 to-blue-400 opacity-20 blur-3xl pointer-events-none z-0"></div>

  <div id="form-success" class="hidden absolute inset-0 bg-white z-30 flex flex-col items-center justify-center text-center p-8 transition-opacity duration-500 opacity-0">
    <div class="w-20 h-20 bg-green-50 text-green-500 rounded-full flex items-center justify-center mb-6 shadow-inner border border-green-100">
      <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
    </div>
    <h3 class="text-3xl font-extrabold text-gray-900 mb-3 tracking-tight">Quote Request Received</h3>
    <p class="text-gray-600 font-medium max-w-md mx-auto leading-relaxed">
      Thank you for reaching out. Our export specialists are reviewing your requirements and will contact you within <span class="font-bold text-brand-600">12 hours</span>.
    </p>
    <button id="reset-form-btn" class="mt-8 text-sm font-bold text-brand-600 hover:text-brand-800 underline transition-colors relative z-40 cursor-pointer">
      Submit another inquiry
    </button>
  </div>

  <div id="form-content" class="relative z-20 transition-opacity duration-300">
    <h2 class="text-2xl md:text-3xl font-extrabold text-gray-900 mb-2 text-center tracking-tight">Let's Talk Business</h2>
    <p class="text-gray-600 text-center mb-6 text-sm md:text-base">
      Drop your details below. Our export specialists will reach out within <span class="font-bold text-brand-600">12 hours</span>.
    </p>

    <form id="b2b-quote-form" class="space-y-4 relative z-30">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label for="name" class="block text-xs font-bold text-gray-700 mb-1 uppercase tracking-wider">Name / Company <span class="text-red-500">*</span></label>
          <input type="text" id="name" name="name" required placeholder="John Doe - Acme Corp" class="block w-full rounded-lg border-gray-200 bg-gray-50 shadow-inner focus:bg-white focus:border-brand-500 focus:ring-2 focus:ring-brand-500 focus:ring-opacity-50 p-2.5 transition-all duration-200 outline-none text-sm relative z-30" />
        </div>
        <div>
          <label for="email" class="block text-xs font-bold text-gray-700 mb-1 uppercase tracking-wider">Email <span class="text-red-500">*</span></label>
          <input type="email" id="email" name="email" required placeholder="john@company.com" class="block w-full rounded-lg border-gray-200 bg-gray-50 shadow-inner focus:bg-white focus:border-brand-500 focus:ring-2 focus:ring-brand-500 focus:ring-opacity-50 p-2.5 transition-all duration-200 outline-none text-sm relative z-30" />
        </div>
      </div>

      <div>
        <label for="mobile" class="block text-xs font-bold text-gray-700 mb-1 uppercase tracking-wider">Mobile / WhatsApp</label>
        <input type="tel" id="mobile" name="mobile" placeholder="+1 (555) 000-0000" class="block w-full rounded-lg border-gray-200 bg-gray-50 shadow-inner focus:bg-white focus:border-brand-500 focus:ring-2 focus:ring-brand-500 focus:ring-opacity-50 p-2.5 transition-all duration-200 outline-none text-sm relative z-30" />
      </div>

      <div>
        <label for="message" class="block text-xs font-bold text-gray-700 mb-1 uppercase tracking-wider">How can we help you? <span class="text-red-500">*</span></label>
        <textarea id="message" name="message" rows="3" required placeholder="e.g., I need 50k bagasse plates to NY next month..." class="block w-full rounded-lg border-gray-200 bg-gray-50 shadow-inner focus:bg-white focus:border-brand-500 focus:ring-2 focus:ring-brand-500 focus:ring-opacity-50 p-2.5 transition-all duration-200 outline-none resize-none text-sm relative z-30"></textarea>
      </div>

      <p id="form-error" class="hidden text-red-500 text-xs font-bold text-center mt-2">Network error. Please try again.</p>

      <button type="submit" id="submit-btn" class="w-full bg-brand-600 text-white font-bold py-3 px-6 rounded-lg shadow-[0_4px_14px_0_rgba(0,118,255,0.39)] hover:shadow-[0_6px_20px_rgba(0,118,255,0.23)] hover:scale-[1.01] transition-all duration-200 text-base flex justify-center items-center gap-2 mt-2 relative z-30 overflow-hidden disabled:opacity-70 disabled:cursor-not-allowed disabled:hover:scale-100 disabled:hover:shadow-[0_4px_14px_0_rgba(0,118,255,0.39)] cursor-pointer">
        <span id="btn-text">Get Your Custom Quote</span>
        <svg id="btn-icon" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 transition-transform" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
        </svg>
        
        <svg id="btn-spinner" class="animate-spin h-5 w-5 hidden" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
      </button>
      
      <p class="text-[11px] text-center text-gray-500 mt-3 flex items-center justify-center gap-1 relative z-30">
        <svg class="w-3.5 h-3.5 text-green-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 5.225-3.34 9.67-8 11.317C5.34 16.67 2 12.225 2 7c0-.682.057-1.35.166-2.001zm11.541 3.708a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
        100% Secure. Zero spam.
      </p>
    </form>
  </div>
</div>

<script define:vars={{ EMAILJS_SERVICE_ID, EMAILJS_TEMPLATE_ID, EMAILJS_PUBLIC_KEY }}>
  function setupQuoteForm() {
    const form = document.getElementById('b2b-quote-form');
    const submitBtn = document.getElementById('submit-btn');
    const btnText = document.getElementById('btn-text');
    const btnIcon = document.getElementById('btn-icon');
    const btnSpinner = document.getElementById('btn-spinner');
    const successOverlay = document.getElementById('form-success');
    const formContent = document.getElementById('form-content');
    const errorMsg = document.getElementById('form-error');
    const resetBtn = document.getElementById('reset-form-btn');

    if (!form) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // UI Lock
      submitBtn.disabled = true;
      if (btnText) btnText.textContent = "Processing...";
      if (btnIcon) btnIcon.classList.add('hidden');
      if (btnSpinner) btnSpinner.classList.remove('hidden');
      if (errorMsg) errorMsg.classList.add('hidden');

      // Package Payload for EmailJS REST API
      const formData = new FormData(form);
      const data = {
        service_id: EMAILJS_SERVICE_ID,
        template_id: EMAILJS_TEMPLATE_ID,
        user_id: EMAILJS_PUBLIC_KEY,
        template_params: {
          name: formData.get('name'),
          email: formData.get('email'),
          mobile: formData.get('mobile'),
          message: formData.get('message')
        }
      };

      try {
        const response = await fetch('https://api.emailjs.com/api/v1.0/email/send', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });

        if (response.ok) {
          // Success Pipeline
          if (formContent && successOverlay) {
            formContent.classList.add('opacity-0', 'pointer-events-none');
            setTimeout(() => {
              successOverlay.classList.remove('hidden');
              setTimeout(() => {
                successOverlay.classList.remove('opacity-0');
                successOverlay.classList.add('opacity-100');
              }, 50);
            }, 300);
          }
          form.reset();
        } else {
          throw new Error('API Rejection');
        }
      } catch (error) {
        if (errorMsg) errorMsg.classList.remove('hidden');
      } finally {
        submitBtn.disabled = false;
        if (btnText) btnText.textContent = "Get Your Custom Quote";
        if (btnIcon) btnIcon.classList.remove('hidden');
        if (btnSpinner) btnSpinner.classList.add('hidden');
      }
    });

    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        if (formContent && successOverlay) {
          successOverlay.classList.remove('opacity-100');
          successOverlay.classList.add('opacity-0');
          setTimeout(() => {
            successOverlay.classList.add('hidden');
            formContent.classList.remove('opacity-0', 'pointer-events-none');
          }, 500);
        }
      });
    }
  }

  document.addEventListener('DOMContentLoaded', setupQuoteForm);
  document.addEventListener('astro:page-load', setupQuoteForm);
</script>