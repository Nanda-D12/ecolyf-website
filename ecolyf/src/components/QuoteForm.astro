---
// quoteForm.astro
---

<div class="max-w-2xl mx-auto bg-white p-6 md:p-8 rounded-xl shadow-[0_8px_30px_rgb(0,0,0,0.08)] border-t-4 border-t-brand-500 relative overflow-hidden">
  <div class="absolute -top-24 -right-24 w-48 h-48 rounded-full bg-gradient-to-br from-brand-400 to-blue-400 opacity-20 blur-3xl pointer-events-none"></div>

  <div class="relative z-10">
    <h2 class="text-2xl md:text-3xl font-extrabold text-gray-900 mb-2 text-center tracking-tight">Let's Talk Business</h2>
    <p class="text-gray-600 text-center mb-6 text-sm md:text-base">
      Drop your details below. Our export specialists will reach out within <span class="font-bold text-brand-600">12 hours</span>.
    </p>

    <form class="space-y-4" action="#" method="POST">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label for="name" class="block text-xs font-bold text-gray-700 mb-1 uppercase tracking-wider">Name / Company <span class="text-red-500">*</span></label>
          <input type="text" id="name" name="name" required placeholder="John Doe - Acme Corp" class="block w-full rounded-lg border-gray-200 bg-gray-50 shadow-inner focus:bg-white focus:border-brand-500 focus:ring-2 focus:ring-brand-500 focus:ring-opacity-50 p-2.5 transition-all duration-200 outline-none text-sm" />
        </div>
        <div>
          <label for="email" class="block text-xs font-bold text-gray-700 mb-1 uppercase tracking-wider">Email <span class="text-red-500">*</span></label>
          <input type="email" id="email" name="email" required placeholder="john@company.com" class="block w-full rounded-lg border-gray-200 bg-gray-50 shadow-inner focus:bg-white focus:border-brand-500 focus:ring-2 focus:ring-brand-500 focus:ring-opacity-50 p-2.5 transition-all duration-200 outline-none text-sm" />
        </div>
      </div>

      <div>
        <label for="mobile" class="block text-xs font-bold text-gray-700 mb-1 uppercase tracking-wider">Mobile / WhatsApp</label>
        <input type="tel" id="mobile" name="mobile" placeholder="+1 (555) 000-0000" class="block w-full rounded-lg border-gray-200 bg-gray-50 shadow-inner focus:bg-white focus:border-brand-500 focus:ring-2 focus:ring-brand-500 focus:ring-opacity-50 p-2.5 transition-all duration-200 outline-none text-sm" />
      </div>

      <div>
        <label for="message" class="block text-xs font-bold text-gray-700 mb-1 uppercase tracking-wider">How can we help you? <span class="text-red-500">*</span></label>
        <textarea id="message" name="message" rows="3" required placeholder="e.g., I need 50k bagasse plates to NY next month..." class="block w-full rounded-lg border-gray-200 bg-gray-50 shadow-inner focus:bg-white focus:border-brand-500 focus:ring-2 focus:ring-brand-500 focus:ring-opacity-50 p-2.5 transition-all duration-200 outline-none resize-none text-sm"></textarea>
      </div>

      <button type="submit" class="w-full bg-brand-600 text-white font-bold py-3 px-6 rounded-lg shadow-[0_4px_14px_0_rgba(0,118,255,0.39)] hover:shadow-[0_6px_20px_rgba(0,118,255,0.23)] hover:scale-[1.01] transition-all duration-200 text-base flex justify-center items-center gap-2 mt-2">
        Get Your Custom Quote
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
        </svg>
      </button>
      
      <p class="text-[11px] text-center text-gray-500 mt-3 flex items-center justify-center gap-1">
        <svg class="w-3.5 h-3.5 text-green-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 5.225-3.34 9.67-8 11.317C5.34 16.67 2 12.225 2 7c0-.682.057-1.35.166-2.001zm11.541 3.708a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
        100% Secure. Zero spam.
      </p>
    </form>
  </div>
</div>