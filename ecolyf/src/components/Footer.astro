---
const year = new Date().getFullYear();
---
<footer class="bg-brand-950 text-brand-200 py-16 border-t border-brand-900 mt-auto relative overflow-hidden">
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-16">
      
      <div class="space-y-6">
        <a href="/" class="text-3xl font-black text-white tracking-tighter block group">
          Eco<span class="text-brand-500 group-hover:text-brand-400 transition-colors">Lyf</span>
        </a>
        <p class="text-brand-200 text-sm leading-relaxed">
          Global manufacturer and exporter of premium, 100% biodegradable bagasse tableware. Engineered for international distributors and high-volume institutional catering.
        </p>
        <div class="flex flex-wrap gap-2">
          <span class="bg-brand-900 text-[10px] uppercase tracking-widest font-bold px-2.5 py-1 rounded border border-brand-800 text-brand-300 shadow-inner">ISO 9001:2015</span>
          <span class="bg-brand-900 text-[10px] uppercase tracking-widest font-bold px-2.5 py-1 rounded border border-brand-800 text-brand-300 shadow-inner">SGS Certified</span>
        </div>
      </div>

      <div>
        <h4 class="text-white font-bold uppercase tracking-[0.2em] text-xs mb-8 border-b border-brand-800 pb-3">Products</h4>
        <ul class="space-y-4 text-sm font-medium">
          <li><a href="/products/10-inch-round-plate" class="text-brand-200 hover:text-white transition-colors flex items-center gap-2 group"><span class="w-1.5 h-1.5 rounded-full bg-brand-800 group-hover:bg-brand-400 transition-colors"></span> Bagasse Round Plates</a></li>
          <li><a href="/products/5-compartment-tray" class="text-brand-200 hover:text-white transition-colors flex items-center gap-2 group"><span class="w-1.5 h-1.5 rounded-full bg-brand-800 group-hover:bg-brand-400 transition-colors"></span> Compartment Meal Trays</a></li>
          <li><a href="/products/6-inch-dessert-plate" class="text-brand-200 hover:text-white transition-colors flex items-center gap-2 group"><span class="w-1.5 h-1.5 rounded-full bg-brand-800 group-hover:bg-brand-400 transition-colors"></span> Dessert & Side Plates</a></li>
          <li class="pt-2"><a href="/products" class="text-brand-400 font-bold hover:text-white flex items-center gap-1 group">View Full Catalog <span class="group-hover:translate-x-1 transition-transform">→</span></a></li>
        </ul>
      </div>

      <div>
        <h4 class="text-white font-bold uppercase tracking-[0.2em] text-xs mb-8 border-b border-brand-800 pb-3">Quick Links</h4>
        <ul class="space-y-4 text-sm font-medium text-brand-200">
          <li><a href="/" class="hover:text-white transition-colors">Home</a></li>
          <li><a href="/products" class="hover:text-white transition-colors">Products</a></li>
          <li><a href="/files/ecolyf-catalogue.pdf" download class="hover:text-white transition-colors">Catalogue</a></li>
          <li><a href="/#about" class="hover:text-white transition-colors">About Us</a></li>
          <li><a href="/#contact" class="hover:text-white transition-colors">Contact</a></li>
          <li><a href="/#quote" class="text-brand-400 font-bold hover:text-white transition-colors">Enquiry</a></li>
        </ul>
      </div>

      <div>
        <h4 class="text-white font-bold uppercase tracking-[0.2em] text-xs mb-8 border-b border-brand-800 pb-3">HQ Contact</h4>
        <address class="not-italic text-sm space-y-5">
          <div class="flex items-start">
            <svg class="w-5 h-5 text-brand-500 mr-4 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
            <span class="text-brand-200 leading-relaxed">Trichy, Tamil Nadu<br/><span class="text-brand-400 text-xs font-bold">India (GMT +5:30)</span></span>
          </div>
          <div class="flex items-center">
            <svg class="w-5 h-5 text-brand-500 mr-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
            <a href="mailto:sales@ecolyf.com" class="text-white hover:text-brand-300 font-bold transition-colors">sales@ecolyf.com</a>
          </div>
          <div class="flex items-center">
            <svg class="w-5 h-5 text-brand-500 mr-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
            <a href="tel:+918608503282" class="text-white hover:text-brand-300 font-bold transition-colors">+91 98765 43210</a>
          </div>
        </address>
      </div>
    </div>

    <div class="border-t border-brand-900 pt-8 flex flex-col md:flex-row justify-between items-center gap-6">
      <div class="flex items-center gap-4">
        <p class="text-[10px] uppercase tracking-widest text-brand-400 font-bold">
          &copy; {year} EcoLyf International.
        </p>
        <span class="h-4 w-px bg-brand-800 hidden md:block"></span>
        <div class="flex space-x-4 text-[10px] font-mono text-brand-500">
          <span title="Import Export Code">IEC: [YOUR-IEC]</span>
          <span title="GST Number">GST: [YOUR-GST]</span>
        </div>
      </div>
      
      <p class="text-[10px] font-black text-brand-500 uppercase tracking-[0.3em]">
        Verified Global Manufacturer
      </p>
    </div>

  </div>
</footer>