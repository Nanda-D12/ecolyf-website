---
const year = new Date().getFullYear();
---
<footer class="bg-gray-950 text-gray-300 py-16 border-t-4 border-green-800 mt-auto">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-16">
      
      <div>
        <span class="text-2xl font-extrabold text-white tracking-tighter mb-6 block">EcoLyf <span class="text-green-500">Plates</span></span>
        <p class="text-gray-400 text-sm leading-relaxed mb-6">
          Global manufacturer and exporter of premium, 100% biodegradable bagasse tableware. Serving international distributors with certified sustainable solutions.
        </p>
        <div class="flex space-x-4">
          <span class="bg-gray-800 text-xs font-bold px-2 py-1 rounded border border-gray-700 text-gray-300">ISO 9001:2015</span>
          <span class="bg-gray-800 text-xs font-bold px-2 py-1 rounded border border-gray-700 text-gray-300">SGS Certified</span>
        </div>
      </div>

      <div>
        <h4 class="text-white font-bold uppercase tracking-wider text-sm mb-6">Export Catalog</h4>
        <ul class="space-y-3 text-sm">
          <li><a href="/products/10-inch-round-plate" class="hover:text-green-400 transition-colors">Bagasse Round Plates</a></li>
          <li><a href="/products/5-compartment-tray" class="hover:text-green-400 transition-colors">Compartment Meal Trays</a></li>
          <li><a href="/products/6-inch-dessert-plate" class="hover:text-green-400 transition-colors">Dessert & Side Plates</a></li>
          <li class="pt-2"><a href="/products" class="hover:text-green-400 transition-colors text-green-500 font-semibold">View Full Catalog &rarr;</a></li>
        </ul>
      </div>

      <div>
        <h4 class="text-white font-bold uppercase tracking-wider text-sm mb-6">Corporate</h4>
        <ul class="space-y-3 text-sm">
          <li><a href="/#logistics" class="hover:text-green-400 transition-colors">Global Logistics & Shipping</a></li>
          <li><a href="/#oem" class="hover:text-green-400 transition-colors">Private Label OEM Services</a></li>
          <li><a href="#" class="hover:text-green-400 transition-colors">Terms of Sale (FOB/CIF)</a></li>
          <li><a href="#" class="hover:text-green-400 transition-colors">Privacy Policy</a></li>
        </ul>
      </div>

      <div>
        <h4 class="text-white font-bold uppercase tracking-wider text-sm mb-6">Global Headquarters</h4>
        <address class="not-italic text-sm space-y-4 text-gray-400">
          <p class="flex items-start">
            <svg class="w-5 h-5 text-green-500 mr-3 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
            <span>EcoLyf International Exports<br/>Kattur<br/>Trichy, Tamil Nadu 625001<br/>India</span>
          </p>
          <p class="flex items-center">
            <svg class="w-5 h-5 text-green-500 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
            <a href="mailto:sales@EcoLyf.com" class="hover:text-white transition-colors">sales@EcoLyf.com</a>
          </p>
          <p class="flex items-center">
            <svg class="w-5 h-5 text-green-500 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
            <a href="tel:+919876543210" class="hover:text-white transition-colors">+91 98765 43210</a>
          </p>
        </address>
      </div>

    </div>

    <div class="border-t border-gray-800 pt-8 flex flex-col md:flex-row justify-between items-center">
      <p class="text-xs text-gray-500 mb-4 md:mb-0">
        &copy; {year} EcoLyf International Exports. All rights reserved. Registered Export Entity.
      </p>
      <div class="flex space-x-6 text-xs text-gray-500 font-mono">
        <span title="Import Export Code">IEC: [ADD-YOUR-IEC-HERE]</span>
        <span title="Goods and Services Tax Identification Number">GSTIN: [ADD-YOUR-GSTIN-HERE]</span>
      </div>
    </div>

  </div>
</footer>