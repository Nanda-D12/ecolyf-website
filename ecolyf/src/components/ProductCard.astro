---
const { product } = Astro.props;
const filterHook = product.category ? product.category.toLowerCase() : 'all';
---

<div class="product-card transition-all duration-300" data-category={filterHook}>
  
  <a href={`/products/${product.slug}`} class="block bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-lg border border-brand-100 transition-all duration-300 transform hover:-translate-y-1 group relative">
    
    <div class="h-64 bg-brand-50 relative overflow-hidden border-b border-brand-100">
      
      <img 
        src={product.image} 
        alt={product.name} 
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out" 
      />
      
      <div class="absolute top-4 left-4 bg-brand-600 text-white text-[10px] font-black px-3 py-1.5 rounded uppercase tracking-[0.15em] border border-brand-700 z-10 shadow-sm">
        {product.category}
      </div>

      <div class="absolute inset-0 bg-gradient-to-t from-brand-950/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
    </div>
    
    <div class="p-6 relative">
      <div class="w-8 h-1 bg-brand-500 mb-4 group-hover:w-16 transition-all duration-500 ease-in-out rounded-full"></div>
      
      <h4 class="text-xl font-black text-brand-950 mb-3 group-hover:text-brand-600 transition-colors leading-tight">
        {product.name}
      </h4>
      
      <p class="text-brand-800 text-sm mb-6 line-clamp-2 font-medium leading-relaxed">
        {product.description}
      </p>
      
      <div class="border-t border-brand-100 pt-5 flex items-center justify-between">
        
        <div class="flex items-center text-brand-600 font-extrabold text-xs uppercase tracking-wider bg-brand-50 border border-brand-100 px-3 py-2 rounded group-hover:bg-brand-600 group-hover:border-brand-600 group-hover:text-white transition-all duration-300">
          Specs 
          <svg class="w-4 h-4 ml-1.5 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
          </svg>
        </div>
      </div>
    </div>

  </a>
</div>