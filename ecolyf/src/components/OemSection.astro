---
// src/components/OemSection.astro
---
<section class="py-24 bg-white border-y border-brand-100 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      
      <div class="relative z-10">
        <h2 class="text-sm font-extrabold text-brand-600 tracking-widest uppercase mb-3">Custom Export Branding</h2>
        
        <h3 class="text-4xl md:text-5xl font-black text-brand-950 mb-6 leading-tight tracking-tight">
          Your Brand. <span class="text-brand-600">Our Quality.</span>
        </h3>
        
        <p class="text-lg text-brand-800 mb-10 leading-relaxed font-medium max-w-xl">
          We don’t just supply standard units; we manage full-cycle customization for your brand. From precision embossing on the tableware to bespoke retail packaging, we handle the entire export branding process for international distributors.
        </p>
        
        <ul class="space-y-6">
          <li class="flex items-center text-brand-950 font-bold text-lg group">
            <span class="bg-brand-500 text-white rounded-full p-2 mr-4 shadow-sm group-hover:bg-brand-600 group-hover:scale-110 transition-all duration-300">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
            </span>
            Custom Logo Embossing
          </li>
          <li class="flex items-center text-brand-950 font-bold text-lg group">
            <span class="bg-brand-500 text-white rounded-full p-2 mr-4 shadow-sm group-hover:bg-brand-600 group-hover:scale-110 transition-all duration-300">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
            </span>
            Tailored Shrink Packaging & Box Design
          </li>
          <li class="flex items-center text-brand-950 font-bold text-lg group">
            <span class="bg-brand-500 text-white rounded-full p-2 mr-4 shadow-sm group-hover:bg-brand-600 group-hover:scale-110 transition-all duration-300">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
            </span>
            End-to-End Export Logistics
          </li>
        </ul>
      </div>

      <div class="relative group">
        <div class="absolute -inset-4 bg-brand-50 border border-brand-100 rounded-[2rem] transform -rotate-2 opacity-100 group-hover:-rotate-3 transition-transform duration-500"></div>
        
        <div class="relative bg-white p-3 rounded-2xl shadow-xl border border-brand-100">
          <div class="bg-brand-50 h-[300px] md:h-[450px] rounded-xl flex flex-col items-center justify-center text-brand-600 font-medium text-lg border-2 border-dashed border-brand-200 overflow-hidden relative">
            
            <img 
              src="/images/OEM-logo.webp" 
              alt="Bagasse plate with custom logo" 
              class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" 
            />
            
            <div class="absolute inset-0 bg-brand-950/10 group-hover:bg-transparent transition-colors duration-500"></div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>