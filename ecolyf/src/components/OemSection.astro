<section class="py-20 bg-gray-50 border-y border-gray-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
      <div>
        <h2 class="text-sm font-bold text-green-700 tracking-widest uppercase mb-2">Private Label Manufacturing</h2>
        <h3 class="text-4xl font-extrabold text-gray-900 mb-6 leading-tight">Your Brand. Our Quality.</h3>
        <p class="text-lg text-gray-600 mb-8">
          We don't just sell standard products; we manufacture for your brand. From custom embossing on the tableware to branded retail packaging, we handle the entire OEM process for international distributors.
        </p>
        <ul class="space-y-4">
          <li class="flex items-center text-gray-800 font-medium">
            <span class="bg-green-100 text-green-800 rounded-full p-1 mr-3"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg></span>
            Custom Logo Embossing
          </li>
          <li class="flex items-center text-gray-800 font-medium">
            <span class="bg-green-100 text-green-800 rounded-full p-1 mr-3"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg></span>
            Tailored Shrink Packaging & Box Design
          </li>
          <li class="flex items-center text-gray-800 font-medium">
            <span class="bg-green-100 text-green-800 rounded-full p-1 mr-3"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg></span>
            End-to-End Export Logistics
          </li>
        </ul>
      </div>
      <div class="bg-white p-2 rounded-xl shadow-2xl border border-gray-100">
        <div class="bg-gray-200 h-96 rounded-lg flex items-center justify-center text-gray-500 font-semibold text-lg">
          [Image: Warehouse / Shipping Container / Branded Boxes]
        </div>
      </div>
    </div>
  </div>
</section>