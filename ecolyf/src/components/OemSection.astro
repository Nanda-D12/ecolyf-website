---
// OemSection.astro
---
<section class="py-24 bg-white border-y border-gray-100 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      
      {/* The Pitch */}
      <div class="relative z-10">
        <h2 class="text-sm font-extrabold text-brand-600 tracking-widest uppercase mb-3">Private Label Manufacturing</h2>
        <h3 class="text-4xl md:text-5xl font-extrabold text-gray-900 mb-6 leading-tight tracking-tight">
          Your Brand. <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-600 to-brand-400">Our Quality.</span>
        </h3>
        <p class="text-lg text-gray-600 mb-10 leading-relaxed font-medium max-w-xl">
          We don't just sell standard products; we manufacture for your brand. From custom embossing on the tableware to branded retail packaging, we handle the entire OEM process for international distributors.
        </p>
        
        {/* High-Impact Benefit List */}
        <ul class="space-y-6">
          <li class="flex items-center text-gray-800 font-bold text-lg group">
            <span class="bg-brand-500 text-white rounded-full p-2 mr-4 shadow-lg shadow-brand-500/30 group-hover:scale-110 transition-transform duration-300">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
            </span>
            Custom Logo Embossing
          </li>
          <li class="flex items-center text-gray-800 font-bold text-lg group">
            <span class="bg-brand-500 text-white rounded-full p-2 mr-4 shadow-lg shadow-brand-500/30 group-hover:scale-110 transition-transform duration-300">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
            </span>
            Tailored Shrink Packaging & Box Design
          </li>
          <li class="flex items-center text-gray-800 font-bold text-lg group">
            <span class="bg-brand-500 text-white rounded-full p-2 mr-4 shadow-lg shadow-brand-500/30 group-hover:scale-110 transition-transform duration-300">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
            </span>
            End-to-End Export Logistics
          </li>
        </ul>
      </div>

      {/* The Visual Frame */}
      <div class="relative group">
        {/* Background decorative blob to add energy */}
        <div class="absolute -inset-4 bg-gradient-to-r from-brand-200 to-brand-100 rounded-[2rem] transform rotate-3 opacity-70 group-hover:rotate-6 transition-transform duration-500"></div>
        
        <div class="relative bg-white p-3 rounded-2xl shadow-xl border border-brand-50">
          <div class="bg-gray-100 h-[450px] rounded-xl flex flex-col items-center justify-center text-gray-400 font-medium text-lg border-2 border-dashed border-gray-300 overflow-hidden relative">
            
            {/* Replace this div with your actual image tag */}
            <svg class="w-16 h-16 mb-4 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
            <span class="text-center px-4">Insert high-quality shot of<br/>branded boxes or warehouse</span>
            
          </div>
        </div>
      </div>

    </div>
  </div>
</section>