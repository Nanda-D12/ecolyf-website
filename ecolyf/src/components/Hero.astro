---
// src/components/Hero.astro
---
<div class="relative bg-brand-50 overflow-hidden">
  
  <img 
    src="/mobile-hero.webp" 
    alt="EcoLyf Bagasse Manufacturing" 
    class="absolute inset-0 w-full h-full object-cover md:hidden" 
  />

  <video 
    autoplay 
    loop 
    muted 
    playsinline 
    class="hidden md:block absolute inset-0 w-full h-full object-cover"
    poster="/mobile-hero.webp"
  >
    <source src="/hero-loop.mp4" type="video/mp4" />
  </video>

  <div class="absolute inset-0 bg-white/85 backdrop-blur-[2px] z-10"></div>

  <div class="relative z-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-32 lg:py-48 flex flex-col items-center text-center">
    
    <span class="text-brand-600 font-extrabold tracking-widest uppercase text-sm mb-4">
      Largest Exporter of Sugarcane Tableware
    </span>
    
    <h1 class="text-5xl md:text-6xl font-black tracking-tight mb-6 leading-tight text-brand-950">
      Sustainable Bagasse Packaging <br/> 
      <span class="text-brand-600">At Global Scale.</span>
    </h1>
    
    <p class="text-xl text-brand-800 mb-10 max-w-2xl font-medium leading-relaxed">
      We manufacture and export 100% biodegradable, compostable, and plastic-free tableware. OEM and custom branding available for global distributors.
    </p>
    
    <div class="flex flex-col sm:flex-row gap-4">
      <a href="/#quote" class="bg-brand-600 text-white font-bold py-4 px-8 rounded shadow-md hover:bg-brand-700 hover:shadow-lg transition-all duration-300 transform hover:-translate-y-1">
        Enquiry
      </a>
    </div>
  </div>
</div>