---
// src/components/Hero.astro
---
<div class="relative bg-brand-50 overflow-hidden">
  
  <img 
    src="/mobile-hero.webp" 
    alt="EcoLyf Bagasse Manufacturing" 
    class="absolute inset-0 w-full h-full object-cover md:hidden" 
  />

  <video 
    autoplay 
    loop 
    muted 
    playsinline 
    class="hidden md:block absolute inset-0 w-full h-full object-cover"
    poster="/mobile-hero.webp"
  >
    <source src="/hero-video.mp4" type="video/mp4" />
  </video>

  <div class="absolute inset-0 bg-gradient-to-b from-grey/70 via-white/65 to-grey/20 z-10 pointer-events-none"></div>

  <div class="relative z-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-32 lg:py-48 flex flex-col items-center text-center">
    
    <span class="text-brand-600 font-extrabold tracking-widest uppercase text-sm mb-4 drop-shadow-sm">
      Global Export & Supply Operations
    </span>
    
    <h1 class="text-5xl md:text-6xl font-black tracking-tight mb-6 leading-tight text-brand-950 drop-shadow-sm">
      Premium Compostable Tableware<br/> 
      <span class="text-brand-600">For a Greener Planet</span>
    </h1>
    
    <p class="text-xl text-brand-800 mb-10 max-w-2xl font-medium leading-relaxed drop-shadow-sm">
      Discover the superior strength and refined finish of our premium bagasse tableware. We manage the high-volume export of 100% compostable, plastic-free solutions designed to meet the rigorous demands of international markets
    </p>
    
    <div class="flex flex-col sm:flex-row gap-4">
      <a href="/#quote" class="bg-brand-600 text-white font-bold py-4 px-10 rounded shadow-[0_4px_14px_rgba(16,185,129,0.3)] hover:bg-brand-500 hover:shadow-[0_6px_20px_rgba(16,185,129,0.5)] hover:scale-105 transition-all duration-300 uppercase tracking-widest text-sm">
        Enquiry
      </a>
    </div>
  </div>
</div>