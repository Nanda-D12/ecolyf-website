---
---
<div class="relative bg-green-950 text-white overflow-hidden">
  
  <img 
    src="/mobile-hero.webp" 
    alt="EcoLyf Bagasse Manufacturing" 
    class="absolute inset-0 w-full h-full object-cover md:hidden" 
  />

  <video 
    autoplay 
    loop 
    muted 
    playsinline 
    class="hidden md:block absolute inset-0 w-full h-full object-cover"
    poster="/mobile-hero.webp"
  >
    <source src="/hero-loop.mp4" type="video/mp4" />
  </video>

<div class="absolute inset-0 bg-gradient-to-br from-green-950/60 to-green-800/40 z-10"></div>

  <div class="relative z-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 lg:py-32 flex flex-col items-center text-center">
    <span class="text-green-300 font-semibold tracking-wider uppercase text-sm mb-4">Largest Exporter of Sugarcane Tableware</span>
    <h1 class="text-5xl md:text-6xl font-extrabold tracking-tight mb-6 leading-tight">
      Sustainable Bagasse Packaging <br/> <span class="text-green-400">At Global Scale.</span>
    </h1>
    <p class="text-xl text-green-100 mb-10 max-w-2xl">
      We manufacture and export 100% biodegradable, compostable, and plastic-free tableware. OEM and custom branding available for global distributors.
    </p>
    <div class="flex flex-col sm:flex-row gap-4">
      <a href="#quote" class="bg-green-600 text-white font-bold py-4 px-8 rounded shadow-xl hover:bg-green-500 transition-all duration-300 transform hover:-translate-y-1">
        Request Container Pricing
      </a>
      <a href="/products" class="bg-transparent border border-green-400 text-green-300 font-bold py-4 px-8 rounded hover:bg-green-900/50 transition-all duration-300">
        Download Catalog
      </a>
    </div>
  </div>

 <div class="relative z-20 bg-green-950/90 backdrop-blur-md border-t border-green-800/70 shadow-2xl">
    <div class="max-w-7xl mx-auto px-4 py-10">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center text-sm lg:text-base font-bold text-green-100 uppercase tracking-widest">
        
        <div class="flex flex-col items-center justify-center gap-3 group">
          <div class="p-4 bg-green-900/50 rounded-full border border-green-700/50 text-green-400 group-hover:bg-green-800/50 group-hover:scale-110 group-hover:text-green-300 transition-all duration-300">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
            </svg>
          </div>
          <span class="group-hover:text-white transition-colors">100% Biodegradable</span>
        </div>

        <div class="flex flex-col items-center justify-center gap-3 group">
          <div class="p-4 bg-green-900/50 rounded-full border border-green-700/50 text-green-400 group-hover:bg-green-800/50 group-hover:scale-110 group-hover:text-green-300 transition-all duration-300">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z"></path>
            </svg>
          </div>
          <span class="group-hover:text-white transition-colors">Microwave & Freeze Safe</span>
        </div>

        <div class="flex flex-col items-center justify-center gap-3 group">
          <div class="p-4 bg-green-900/50 rounded-full border border-green-700/50 text-green-400 group-hover:bg-green-800/50 group-hover:scale-110 group-hover:text-green-300 transition-all duration-300">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
            </svg>
          </div>
          <span class="group-hover:text-white transition-colors">PFAS & Toxin Free</span>
        </div>

        <div class="flex flex-col items-center justify-center gap-3 group">
          <div class="p-4 bg-green-900/50 rounded-full border border-green-700/50 text-green-400 group-hover:bg-green-800/50 group-hover:scale-110 group-hover:text-green-300 transition-all duration-300">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"></path>
            </svg>
          </div>
          <span class="group-hover:text-white transition-colors">Export Certified</span>
        </div>

      </div>
    </div>
  </div>
</div>