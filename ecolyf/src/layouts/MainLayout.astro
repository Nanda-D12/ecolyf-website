---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import WhatsappButton from '../components/WhatsappButton.astro';

interface Props {
  title?: string;
  description?: string;
}

// Dynamic injection with aggressive B2B defaults
const { 
  title = "Bagasse Plates Exporter India | Bulk Compostable Tableware | EcoLyf", 
  description = "Premium bagasse plates, bowls, and clamshells exported direct from India to Europe. ISO certified, EN13432 compliant. Wholesale PFAS-free manufacturing." 
} = Astro.props;

const siteUrl = Astro.site?.toString() || 'https://eco-lyf.com';
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const gaTrackingId = import.meta.env.PUBLIC_GA_ID; // Configure via .env to decouple dev from prod

// Elite Schema Generation for Google's Knowledge Graph
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${siteUrl}/#organization`,
  "name": "EcoLyf",
  "alternateName": "EcoLyf International Exports",
  "url": siteUrl,
  "logo": {
    "@type": "ImageObject",
    "url": `${siteUrl}/ecolyf-icon.svg`
  },
  "description": "Direct manufacturer and exporter of EN13432 certified bagasse tableware. Supplying wholesale compostable packaging to the UK, EU, and global markets.",
  "contactPoint": [
    {
      "@type": "ContactPoint",
      "telephone": "+91-8608503282",
      "contactType": "Sales",
      "email": "sales@eco-lyf.com",
      "availableLanguage": ["English"]
    }
  ],
  "areaServed": [
    {"@type": "Country", "name": "United Kingdom"},
    {"@type": "Country", "name": "Germany"},
    {"@type": "Country", "name": "France"},
    {"@type": "Country", "name": "Spain"}
  ]
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${siteUrl}/#website`,
  "name": "EcoLyf Export Catalog",
  "url": siteUrl,
  "publisher": {
    "@id": `${siteUrl}/#organization`
  },
  "potentialAction": {
    "@type": "SearchAction",
    "target": `${siteUrl}/search?q={search_term_string}`,
    "query-input": "required name=search_term_string"
  }
};

// Add this under your websiteSchema in MainLayout.astro
const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": `${siteUrl}/#localbusiness`,
  "name": "EcoLyf International",
  "image": `${siteUrl}/ecolyf-icon.svg`,
  "telephone": "+91-8608503282", // Your exact phone number
  "email": "sales@eco-lyf.com",
  "priceRange": "$$",
  "address": {
    "@type": "No. 5, Thirumurugan Nagar Extension, Pappakurichi Main Road, North Kattur, Trichy, Tamil Nadu - 620019",
    "streetAddress": "No. 5, Thirumurugan Nagar Extension, Pappakurichi Main Road, North Kattur",
    "addressLocality": "Trichy",
    "addressRegion": "Tamil Nadu",
    "postalCode": "620019",
    "addressCountry": "IN"
  },
  "areaServed": ["GB", "DE", "FR", "ES"],
  "serviceType": ["B2B Supply", "Wholesale", "Export"]
};
---

<html lang="en" class="scroll-smooth">
  <head>
    {gaTrackingId && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaTrackingId}`}></script>
        <script is:inline define:vars={{ gaTrackingId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', gaTrackingId);
        </script>
      </>
    )}

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/svg+xml" href="/ecolyf-icon.svg" />
    
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="EcoLyf Export" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}/images/og-image.webp`} />
    
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
  </head>
  
  <body class="bg-white text-brand-950 font-sans antialiased flex flex-col min-h-screen">
    <Navbar />
    
    <main class="flex-grow">
      <slot /> 
    </main>
    
    <Footer />
    <WhatsappButton />
  </body>
</html>