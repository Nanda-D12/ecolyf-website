---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import WhatsappButton from '../components/WhatsappButton.astro';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "EcoLyf | Global Exporter & Supply Chain Manager", 
  description = "Institutional-grade supply of 100% biodegradable bagasse tableware. Sustainable export operations at global scale." 
} = Astro.props;

const siteUrl = Astro.site?.toString() || 'https://eco-lyf.com';
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const gaTrackingId = import.meta.env.PUBLIC_GA_ID; // Configure via .env to decouple dev from prod
---

<html lang="en" class="scroll-smooth">
  <head>
    {gaTrackingId && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaTrackingId}`}></script>
        <script is:inline define:vars={{ gaTrackingId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', gaTrackingId);
        </script>
      </>
    )}

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/ecolyf-icon.svg" />
    
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  
  <body class="bg-white text-brand-950 font-sans antialiased flex flex-col min-h-screen">
    <Navbar />
    
    <main class="flex-grow">
      <slot /> 
    </main>
    
    <Footer />
    <WhatsappButton />
  </body>
</html>